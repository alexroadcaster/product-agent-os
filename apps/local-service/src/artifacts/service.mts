 function nativeCheck(row:StoredEntity,run:any,op:any,rows:StoredEntity[]):{item:ArtifactItem;body:string;redacted:boolean}{
  const publicReceipt={operationId:op.operationId,argv:op.argv??[],state:op.state,exitCode:op.exitCode??null,stdout:op.stdout??'',stderr:op.stderr??''},version=hash(publicReceipt),taskId=text(run.taskContext?.taskId??run.taskId),sessionId=text(run.sessionId),id='runtime-check-'+hash([row.projectId,row.id,op.operationId]);
  const rawBody=JSON.stringify(publicReceipt,null,2),body=safePersistedText(rawBody),bound=rows.find(t=>t.id===taskId&&t.kind==='task'),pinned=run.taskContext?.revision,stale=typeof pinned==='number'&&Boolean(bound)&&bound!.revision!==pinned;return {item:{id,kind:'check',title:'Native command · '+op.operationId,preview:body.slice(0,280),source:{path:null,version,observedAt:new Date().toISOString(),modifiedAt:row.updatedAt,state:'observed',origin:'runtime_receipt'},taskIds:taskId?[taskId]:[],sessionIds:sessionId?[sessionId]:[],runIds:[row.id],coverage:'partial',status:op.state,check:{outcome:op.state==='completed'?(op.exitCode===0?'passed':'failed'):op.state,command:safePersistedText(JSON.stringify(op.argv??[])),environment:null,sourceVersion:text(run.workflowSnapshot?.definitionHash)??(run.taskContext?.revision?'task:'+run.taskContext.revision:null),scope:text(run.taskContext?.scopeDigest),criteria:safeVisibleValue(run.taskContext?.acceptanceCriteria??null),stale,sourceState:!bound||typeof pinned!=='number'?'unknown':stale?'stale':'matching',acceptance:'separate_owner_record_required'}},body,redacted:body!==rawBody};
