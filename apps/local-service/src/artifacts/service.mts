   }catch{reasons.push('unavailable_source');}}
  await assertSourceProject(p);if(!sourceEntries.has(projectId)&&sourceEntries.size>=20){const oldest=sourceEntries.keys().next().value!;sourceEntries.delete(oldest);runtimeEntries.delete(oldest);}sourceEntries.set(projectId,sources);return {indexed,reasons:[...new Set(reasons)]};
 }
 async function catalog(projectId:string,query:URLSearchParams):Promise<ArtifactPage>{
  const limit=Number(query.get('limit')??50);if(!Number.isSafeInteger(limit)||limit<1||limit>100)fail('INVALID_PAGINATION');const q=safePersistedText(query.get('q')??'').toLowerCase();if(q.length>512)fail('INVALID_QUERY');const kind=query.get('kind')??'all',taskId=query.get('taskId')??'',scope=JSON.stringify([projectId,q,kind,taskId]);let snapshot:any,offset=0,key='';
  if(query.has('cursor')){let cursor:any;try{cursor=JSON.parse(Buffer.from(query.get('cursor')!,'base64url').toString());}catch{fail('CURSOR_INVALID');}key=cursor.key;offset=cursor.offset;snapshot=snapshots.get(key);if(!snapshot||snapshot.scope!==scope||snapshot.until<Date.now())fail('CURSOR_STALE');if(!Number.isSafeInteger(offset)||offset<0||offset>snapshot.items.length)fail('CURSOR_INVALID');}
  else{for(const [key,s] of snapshots)if(s.until<Date.now())snapshots.delete(key);const result=await collect(projectId);if(q&&graph&&kind==='all'){try{const status=await graph.status(projectId);if(status.revision){const page=await graph.graph(projectId,new URLSearchParams({revision:status.revision,query:q,limit:'100'}));for(const node of page.nodes)result.indexed.push({item:{id:node.id,kind:node.kind==='file'?'code_file':'symbol',title:node.name,preview:node.relativePath+' · '+node.scope,source:{path:node.relativePath,version:page.revision,observedAt:new Date().toISOString(),modifiedAt:null,state:page.state==='fresh'?'observed':'stale',origin:'code_index'},taskIds:[],sessionIds:[],runIds:[],coverage:'partial',status:page.state},search:(node.name+' '+node.relativePath).toLowerCase()});if(page.partial)result.reasons.push('code_search_partial');}else result.reasons.push('code_index_unavailable');}catch{result.reasons.push('code_index_unavailable');}}const selected=result.indexed.filter(row=>(kind==='all'||kind==='documents'&&['document','proposal'].includes(row.item.kind)||kind==='checks'&&['check','acceptance'].includes(row.item.kind)||row.item.kind===kind)&&(!q||row.search.includes(q))&&(!taskId||row.item.taskIds.includes(taskId))).map(row=>row.item);const bytes=Buffer.byteLength(JSON.stringify(selected));if(snapshots.size>=50||bytes>8*1024*1024||[...snapshots.values()].reduce((n,s)=>n+s.bytes,0)+bytes>32*1024*1024)fail('ARTIFACT_SNAPSHOT_BUSY');key=randomUUID();snapshot={scope,items:selected,at:new Date().toISOString(),until:Date.now()+15*60_000,bytes,reasons:result.reasons};snapshots.set(key,snapshot);}
  return {items:snapshot.items.slice(offset,offset+limit),nextCursor:offset+limit<snapshot.items.length?Buffer.from(JSON.stringify({key,offset:offset+limit})).toString('base64url'):null,total:snapshot.items.length,coverage:'partial',reasons:snapshot.reasons,observedAt:snapshot.at};
