  const taskIds=[...new Set([...(row.kind==='task'?[row.id]:[]),...ids(d.taskIds),...((row.kind==='comment'||row.kind==='evidence')&&row.parentId&&rows.some(r=>r.id===row.parentId&&r.kind==='task')?[row.parentId]:[]),...(text(d.taskId??receipt.taskId)?[String(d.taskId??receipt.taskId)]:[])])];
