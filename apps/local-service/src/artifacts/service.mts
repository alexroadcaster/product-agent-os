  if(entry){
   const source={path:entry.path,version:version??entry.version,observedAt:new Date().toISOString(),modifiedAt:null,state:'observed' as const,origin:'workspace_file' as const};selected={id,kind:'document',title:entry.path,preview:'',source,taskIds:[],sessionIds:[],runIds:[],coverage:'partial',status:'read_only'};
   try{const file=await readCheckedSource(p,entry.path,512*1024);if(file.hash!==source.version)return {item:{...selected,source:{...source,state:'stale'}},body:null,outline:[],redacted:false,state:'stale',observedVersion:file.hash};body=safePersistedText(file.text);redacted=body!==file.text;selected.source.modifiedAt=file.modifiedAt??null;}catch{return {item:{...selected,source:{...source,state:'unavailable'}},body:null,outline:[],redacted:false,state:'unavailable'};}
   const rows=await store.projectEntities(projectId);selected.taskIds=rows.filter(t=>t.kind==='task'&&taskPaths(t).includes(entry.path)).map(t=>t.id);selected.sessionIds=rows.filter(t=>selected.taskIds.includes(t.id)).flatMap(t=>ids(t.data.sessionIds));
  }else{const row=await store.get(projectId,id);if(!row||!['document','task','session','message','comment','evidence'].includes(row.kind)||row.kind==='message'&&isHiddenMessage(row))fail('DOCUMENT_NOT_FOUND');const rows=await store.projectEntities(projectId);selected=item(row,rows);if(version&&version!==selected.source.version)return {item:selected,body:null,outline:[],redacted:false,state:'stale',observedVersion:selected.source.version};body=safePersistedText(row.body);redacted=body!==row.body;
   if(row.data.category==='document_proposal'){const d=row.data;let state:'staged'|'stale'='staged';try{const target=await read(projectId,String(d.targetId),String(d.targetVersion));if(target.state!=='available')state='stale';}catch{state='stale';}return {item:selected,body,outline:[],redacted,state:'available',proposal:{before:safePersistedText(String(d.before??'')),after:body,targetId:String(d.targetId),targetVersion:String(d.targetVersion),state,applied:false}};}}
  const outline=body.split(/\r?\n/).flatMap((line,i)=>{const m=/^(#{1,6})\s+(.+)$/.exec(line);return m?[{level:m[1].length,text:m[2].slice(0,200),line:i+1}]:[]}).slice(0,200);return {item:selected,body,outline,redacted,state:'available'};
