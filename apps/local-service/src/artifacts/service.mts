  async saveProposal(projectId:string,actorId:string,input:any){if(typeof input.idempotencyKey!=='string'||input.idempotencyKey.length>200||!Number.isSafeInteger(input.epoch))fail('DOCUMENT_PROPOSAL_INVALID');const id='doc-proposal-'+hash([projectId,input.idempotencyKey]),requestHash=hash([input.documentId,input.sourceVersion,input.body,input.previewDigest]);const old=await store.get(projectId,id);if(old){if(old.data.requestHash!==requestHash)fail('IDEMPOTENCY_CONFLICT');return {id,staged:true,replayed:true};}const plan=await preview(projectId,input);if(plan.previewDigest!==input.previewDigest)fail('DOCUMENT_PROPOSAL_STALE');const target=await read(projectId,input.documentId,input.sourceVersion);await store.write({projectId,actorId,expectedAuthorityEpoch:input.epoch,idempotencyKey:input.idempotencyKey,changes:[{expectedRevision:0,entity:{id,kind:'document',title:'Proposal: '+target.item.title,body:input.body,data:{category:'document_proposal',targetId:input.documentId,targetVersion:plan.sourceVersion,before:plan.before,requestHash,taskIds:target.item.taskIds}}}]});return {id,staged:true,replayed:false};}
