import {createHash,createHmac,randomBytes,timingSafeEqual} from 'node:crypto';
import {extname} from 'node:path';
import {readFile} from 'node:fs/promises';
import {inventoryForProject,readCheckedSource,type SourceProject} from '../code-index/sources.mts';
import {inventoryScopeFingerprint} from '../project-inventory/scope.mts';
import {normaliseRelativePath} from '../project-inventory/service.mts';
import type {StaticFile} from './analyzer.mts';
import {parserVersion} from './version.mts';
import {runCodeDatabaseAnalysis} from './runner.mts';
import type {ScanAnalyzerContext,ScanAnalyzerResult} from '../project-scans/service.mts';
import type {CodeDatabaseLink,CodeDatabaseStatus,CodeDatabasePage} from '../../../../packages/contracts/code-database.ts';
export type CodeDatabaseStore={project(id:string):Promise<SourceProject|null>;readProjectState(id:string,namespace:'project_code_database_v1'):Promise<{version:number;value:unknown}|null>;writeProjectState(id:string,namespace:'project_code_database_v1',version:number,value:unknown):Promise<unknown>};
type Dependencies={store:CodeDatabaseStore;codeIndex:{status(id:string):Promise<{state:string;revision?:string}>};databaseMap:{status(id:string):Promise<{state:string;snapshotRevision:string|null;version?:number;source:{relativePath:string}|null}>;snapshot(id:string,query?:URLSearchParams):Promise<{state:string;snapshot:{projectId:string;rootIdentity:string;policyVersion:string;revision:string;relativePath:string};tables:Array<{name:string}>;nextCursor:string|null}>}};
type ManifestFile={relativePath:string;hash:string;fileRevision:string;byteSize:number};
type RecordState={schemaVersion:'paos_code_database_record_v1';projectId:string;scope:string;inventoryRevision:string;policyVersion:string;codeRevision:string;schemaRevision:string;schemaVersionPin:number|null;sourcePath:string;revision:string;engine:string;files:ManifestFile[];links:CodeDatabaseLink[];candidates:Record<string,string[]>;reasons:string[];partial:boolean};
const limits=Object.freeze({fileBytes:512*1024,bytes:8*1024*1024,files:1000,links:1000,stateBytes:1024*1024,contextBytes:32768,milliseconds:30000});
const hash=(v:unknown)=>createHash('sha256').update(JSON.stringify(v)).digest('hex');
const fail=(code:string):never=>{throw Object.assign(new Error(code),{code});};
const supported=new Set(['.js','.mjs','.cjs','.jsx','.ts','.mts','.cts','.tsx','.sql','.prisma']);
const unsupported=new Set(['.py','.go','.rs','.java','.cs','.c','.cpp','.rb','.vue','.svelte']);
const reasonsBound=(values:string[])=>{const unique=[...new Set(values.map(v=>v.slice(0,256)))].sort();return unique.length<=64?unique:[...unique.slice(0,63),'warnings_truncated'];};
async function engine(){const source=await Promise.all(['./service.mts','./analyzer.mts','./sql.mts','./runner.mts','./parser-child.mts','./version.mts','../process/child-watchdog.mts'].map(path=>readFile(new URL(path,import.meta.url))));return hash([parserVersion,...source.map(buffer=>createHash('sha256').update(buffer).digest('hex'))]);}
/** Read-only source analysis. Durable records contain bounded structural labels/hashes, never raw SQL, row values or DSNs. */
export function createCodeDatabase(deps:Dependencies){
 const {store}=deps,busy=new Set<string>(),secret=randomBytes(32);
 async function project(id:string){const p=await store.project(id);if(!p)fail('PROJECT_NOT_FOUND');return p!;}
 async function saved(id:string){const row=await store.readProjectState(id,'project_code_database_v1');if(!row)return {version:0,value:null};const value=row.value as RecordState;
  try{if(!value||value.schemaVersion!=='paos_code_database_record_v1'||value.projectId!==id||!Array.isArray(value.files)||value.files.length>limits.files||!Array.isArray(value.links)||value.links.length>limits.links||!Array.isArray(value.reasons)||value.reasons.length>64||!value.candidates||typeof value.candidates!=='object'||Array.isArray(value.candidates)||Buffer.byteLength(JSON.stringify(value))>limits.stateBytes)fail('CODE_DATABASE_STATE_UNAVAILABLE');for(const f of value.files)if(normaliseRelativePath(f.relativePath)!==f.relativePath||typeof f.hash!=='string'||typeof f.fileRevision!=='string')fail('CODE_DATABASE_STATE_UNAVAILABLE');if(normaliseRelativePath(value.sourcePath)!==value.sourcePath||typeof value.scope!=='string'||typeof value.engine!=='string'||typeof value.revision!=='string'||typeof value.codeRevision!=='string'||typeof value.schemaRevision!=='string'||value.reasons.some(r=>typeof r!=='string'||r.length>256))fail('CODE_DATABASE_STATE_UNAVAILABLE');const paths=new Set(value.files.map(f=>f.relativePath));for(const entries of Object.values(value.candidates))if(!Array.isArray(entries)||entries.length>50||entries.some(path=>typeof path!=='string'||!paths.has(path)||normaliseRelativePath(path)!==path))fail('CODE_DATABASE_STATE_UNAVAILABLE');for(const link of value.links)if(!paths.has(link.relativePath)||!['confirmed','inferred','unresolved'].includes(link.confidence)||!['read','write','schema','unknown'].includes(link.operation)||!Number.isSafeInteger(link.span.start.line)||link.span.start.line<1||link.codeRevision!==value.codeRevision||link.schemaRevision!==value.schemaRevision)fail('CODE_DATABASE_STATE_UNAVAILABLE');}catch{fail('CODE_DATABASE_STATE_UNAVAILABLE');}return {version:row.version,value};
 }
 async function pins(id:string){const [code,db]=await Promise.all([deps.codeIndex.status(id),deps.databaseMap.status(id)]);if(code.state!=='fresh'||!code.revision)fail('CODE_DATABASE_CODE_NOT_CURRENT');if(!['ready','partial'].includes(db.state)||!db.snapshotRevision||!db.source)fail('CODE_DATABASE_SCHEMA_NOT_CURRENT');return {codeRevision:code.revision!,schemaRevision:db.snapshotRevision!,sourcePath:normaliseRelativePath(db.source!.relativePath),schemaVersionPin:db.version??null};}
 async function verify(p:SourceProject,record:Pick<RecordState,'scope'|'inventoryRevision'|'policyVersion'|'codeRevision'|'schemaRevision'|'schemaVersionPin'|'sourcePath'>){const current=await project(p.id);if(inventoryScopeFingerprint(current)!==record.scope||inventoryScopeFingerprint(current)!==inventoryScopeFingerprint(p))fail('CODE_DATABASE_SCOPE_STALE');const observed=await inventoryForProject(current).snapshot(current);if(observed.revision!==record.inventoryRevision||observed.policyVersion!==record.policyVersion)fail('CODE_DATABASE_SOURCE_STALE');if(hash(await pins(p.id))!==hash({codeRevision:record.codeRevision,schemaRevision:record.schemaRevision,sourcePath:record.sourcePath,schemaVersionPin:record.schemaVersionPin}))fail('CODE_DATABASE_REVISION_STALE');}
 const empty=(id:string,reasons:string[]):CodeDatabaseStatus=>({schemaVersion:'paos_code_database_v1',projectId:id,state:'unavailable',codeRevision:null,schemaRevision:null,revision:null,sourcePath:null,counts:{links:0,confirmed:0,inferred:0,unresolved:0},reasons});
 function view(id:string,value:RecordState,state:CodeDatabaseStatus['state'],extra:string[]=[]):CodeDatabaseStatus{return {schemaVersion:'paos_code_database_v1',projectId:id,state,codeRevision:value.codeRevision,schemaRevision:value.schemaRevision,revision:value.revision,sourcePath:value.sourcePath,counts:{links:value.links.length,confirmed:value.links.filter(l=>l.confidence==='confirmed').length,inferred:value.links.filter(l=>l.confidence==='inferred').length,unresolved:value.links.filter(l=>l.confidence==='unresolved').length},reasons:reasonsBound([...value.reasons,...extra])};}
 async function status(id:string):Promise<CodeDatabaseStatus>{const p=await project(id),row=await saved(id);if(!row.value)return empty(id,['CODE_DATABASE_NOT_OBSERVED']);try{if(row.value.engine!==await engine())fail('CODE_DATABASE_ENGINE_CHANGED');await verify(p,row.value);return view(id,row.value,row.value.partial?'partial':'fresh');}catch(error){return view(id,row.value,'stale',[String((error as any).code??'CODE_DATABASE_UNAVAILABLE')]);}}
 async function analyzer(context:ScanAnalyzerContext):Promise<ScanAnalyzerResult>{const p=context.project;if(busy.has(p.id))return {state:'unavailable',reasons:['CODE_DATABASE_BUSY']};busy.add(p.id);const started=Date.now(),check=()=>{if(context.signal.aborted||!context.canPublish())fail('CODE_DATABASE_CANCELLED');if(Date.now()-started>limits.milliseconds)fail('CODE_DATABASE_TIMEOUT');};
  try{check();const current=await project(p.id);if(inventoryScopeFingerprint(current)!==inventoryScopeFingerprint(p))fail('CODE_DATABASE_SCOPE_STALE');let pin:Awaited<ReturnType<typeof pins>>;try{pin=await pins(p.id);}catch(error){const code=String((error as any).code??'');if(['CODE_DATABASE_CODE_NOT_CURRENT','CODE_DATABASE_SCHEMA_NOT_CURRENT'].includes(code))return {state:'unavailable',reasons:[code]};throw error;}const inventory=await inventoryForProject(p).snapshot(p,{signal:context.signal});if(inventory.revision!==context.inventory.revision)fail('CODE_DATABASE_SOURCE_STALE');const row=await saved(p.id),fingerprint=await engine();const schema=await deps.databaseMap.snapshot(p.id,new URLSearchParams({revision:pin.schemaRevision,limit:'200'}));if(schema.state!=='current'||schema.snapshot.projectId!==p.id||schema.snapshot.rootIdentity!==p.rootIdentity||schema.snapshot.policyVersion!==inventory.policyVersion||schema.snapshot.revision!==pin.schemaRevision||schema.snapshot.relativePath!==pin.sourcePath||schema.nextCursor)fail('CODE_DATABASE_SCHEMA_NOT_CURRENT');
   const reasons:string[]=inventory.coverage==='partial'?['inventory_partial']:[],planned:string[]=[];let bytes=0;for(const entry of inventory.entries){if(entry.kind!=='file'||!entry.access.readable)continue;const extension=extname(entry.relativePath).toLowerCase();if(!supported.has(extension)&&!unsupported.has(extension))continue;if(entry.byteSize>limits.fileBytes){reasons.push('file_byte_limit:'+entry.relativePath);continue;}if(bytes+entry.byteSize>limits.bytes||planned.length>=limits.files){reasons.push('source_aggregate_limit');continue;}bytes+=entry.byteSize;planned.push(entry.relativePath);}
   const files:StaticFile[]=[],manifest:ManifestFile[]=[];let next=0;const reads=await Promise.allSettled(Array.from({length:Math.min(8,planned.length)},async()=>{for(;;){check();const at=next++;if(at>=planned.length)return;const path=planned[at];try{const file=await readCheckedSource(p,path,limits.fileBytes);check();files.push({relativePath:path,text:file.text});manifest.push({relativePath:path,hash:file.hash,fileRevision:file.fileRevision,byteSize:file.byteSize});}catch(error){const code=String((error as any).code??'CODE_DATABASE_READ_UNAVAILABLE');if(['GRAPH_SOURCE_LIMIT','GRAPH_SOURCE_ENCODING','GRAPH_SOURCE_FORBIDDEN','EACCES','EPERM'].includes(code))reasons.push(code+':'+path);else throw error;}await context.onProgress(at+1,planned.length);}}));const rejected=reads.find((r):r is PromiseRejectedResult=>r.status==='rejected');if(rejected)throw rejected.reason;check();files.sort((a,b)=>a.relativePath.localeCompare(b.relativePath));manifest.sort((a,b)=>a.relativePath.localeCompare(b.relativePath));
   const analyzed=await runCodeDatabaseAnalysis(files,{...pin,tables:schema.tables.map(t=>t.name),maxLinks:limits.links},{signal:context.signal,milliseconds:Math.max(1,Math.min(10000,limits.milliseconds-(Date.now()-started)))});check();const candidates:Record<string,string[]>=Object.create(null);for(const table of new Set(analyzed.links.map(l=>l.table))){if(table==='?')continue;candidates[table]=files.filter(f=>/(?:^|\/)(?:tests?|__tests__)\/|\.(?:test|spec)\.[cm]?[jt]sx?$/.test(f.relativePath)&&f.text.toLowerCase().includes(table.toLowerCase())).map(f=>f.relativePath).slice(0,50);}
   const value:RecordState={schemaVersion:'paos_code_database_record_v1',projectId:p.id,scope:inventoryScopeFingerprint(p),inventoryRevision:inventory.revision,policyVersion:inventory.policyVersion,...pin,revision:hash([pin,manifest,fingerprint,analyzed.links]),engine:fingerprint,files:manifest,links:analyzed.links,candidates,reasons:reasonsBound([...reasons,...analyzed.reasons]),partial:reasons.length>0||analyzed.reasons.some(r=>r!=='static_subset_not_runtime_call_graph')||analyzed.links.some(l=>l.confidence!=='confirmed')};if(Buffer.byteLength(JSON.stringify(value))>limits.stateBytes)fail('CODE_DATABASE_STATE_LIMIT');
   // Raw hashes are rechecked before final authority/pin/CAS fences. A cancelled generation cannot publish late.
   let verifyNext=0;const validations=await Promise.allSettled(Array.from({length:Math.min(8,manifest.length)},async()=>{for(;;){check();const at=verifyNext++;if(at>=manifest.length)return;const expected=manifest[at],observed=await readCheckedSource(p,expected.relativePath,limits.fileBytes);if(observed.hash!==expected.hash||observed.fileRevision!==expected.fileRevision)fail('CODE_DATABASE_SOURCE_STALE');}}));const invalid=validations.find((r):r is PromiseRejectedResult=>r.status==='rejected');if(invalid)throw invalid.reason;
   check();await verify(p,value);await context.publicationGuard();check();await verify(p,value);if(await engine()!==fingerprint)fail('CODE_DATABASE_ENGINE_CHANGED');check();await store.writeProjectState(p.id,'project_code_database_v1',row.version,value);return {state:value.partial?'partial':'completed',counts:{links:value.links.length,confirmed:value.links.filter(l=>l.confidence==='confirmed').length},reasons:value.reasons,data:{revision:value.revision,codeRevision:value.codeRevision,schemaRevision:value.schemaRevision,metrics:analyzed.metrics}};
  }finally{busy.delete(p.id);}
 }
 async function query(id:string,params:URLSearchParams):Promise<CodeDatabasePage>{const allowed=['table','path','operation','op','confidence','limit','cursor','codeRevision','schemaRevision'];if([...params.keys()].some(k=>!allowed.includes(k)||params.getAll(k).length!==1)||params.has('op')&&params.has('operation'))fail('CODE_DATABASE_QUERY_INVALID');const limit=Number(params.get('limit')??50),operation=params.get('operation')??params.get('op'),confidence=params.get('confidence'),table=params.get('table'),path=params.get('path');if(!Number.isSafeInteger(limit)||limit<1||limit>100||operation&&!['read','write','schema','unknown'].includes(operation)||confidence&&!['confirmed','inferred','unresolved'].includes(confidence)||table&&table.length>256||(params.get('cursor')?.length??0)>2048)fail('CODE_DATABASE_QUERY_INVALID');if(path)normaliseRelativePath(path);if(!params.get('codeRevision')||!params.get('schemaRevision'))fail('CODE_DATABASE_REVISION_REQUIRED');const p=await project(id),row=await saved(id),value=row.value;if(!value)fail('CODE_DATABASE_NOT_OBSERVED');if(value!.engine!==await engine())fail('CODE_DATABASE_ENGINE_CHANGED');await verify(p,value!);if(params.get('codeRevision')!==value!.codeRevision||params.get('schemaRevision')!==value!.schemaRevision)fail('CODE_DATABASE_REVISION_STALE');const selected=value!.links.filter(l=>(!table||l.table===table)&&(!path||l.relativePath===path||l.relativePath.startsWith(path+'/'))&&(!operation||l.operation===operation)&&(!confidence||l.confidence===confidence));
   const binding=hash([id,value!.revision,value!.scope,value!.inventoryRevision,[...params].filter(([key])=>key!=='cursor').sort(([a],[b])=>a.localeCompare(b))]);let offset=0;if(params.has('cursor'))try{const [payload,signature,extra]=params.get('cursor')!.split('.'),expected=createHmac('sha256',secret).update(payload).digest('base64url');if(extra||signature?.length!==expected.length||!timingSafeEqual(Buffer.from(signature),Buffer.from(expected)))fail('CODE_DATABASE_CURSOR_INVALID');const cursor=JSON.parse(Buffer.from(payload,'base64url').toString());if(cursor.binding!==binding||!Number.isSafeInteger(cursor.offset)||cursor.offset<0||cursor.offset>selected.length)fail('CODE_DATABASE_CURSOR_STALE');offset=cursor.offset;}catch(error){if((error as any).code==='CODE_DATABASE_CURSOR_STALE')throw error;fail('CODE_DATABASE_CURSOR_INVALID');}
   const encode=(at:number)=>{const payload=Buffer.from(JSON.stringify({binding,offset:at})).toString('base64url');return payload+'.'+createHmac('sha256',secret).update(payload).digest('base64url');};
   const testCandidates=[...new Set(selected.flatMap(l=>Object.hasOwn(value!.candidates,l.table)?value!.candidates[l.table]:[]))].sort().slice(0,50).map(relativePath=>({relativePath,reason:'literal_table_mention_static_candidate_not_execution_proof'}));const result:CodeDatabasePage={...view(id,value!,value!.partial?'partial':'fresh'),links:[],testCandidates,nextCursor:null,total:selected.length,contextBytes:0,truncated:false};if(result.reasons.length>16){result.reasons=[...result.reasons.slice(0,15),'additional_warnings_in_status'];result.truncated=true;}while(Buffer.byteLength(JSON.stringify(result))>limits.contextBytes/2&&result.testCandidates.length){result.testCandidates.pop();result.truncated=true;}for(const link of selected.slice(offset,offset+limit)){result.links.push(link);if(Buffer.byteLength(JSON.stringify(result))>limits.contextBytes-1024){result.links.pop();result.truncated=true;break;}}if(!result.links.length&&offset<selected.length)fail('CODE_DATABASE_CONTEXT_LIMIT');result.nextCursor=offset+result.links.length<selected.length?encode(offset+result.links.length):null;result.truncated||=!!result.nextCursor;while(Buffer.byteLength(JSON.stringify(result))>limits.contextBytes-128&&result.testCandidates.length){result.testCandidates.pop();result.truncated=true;}for(let n=0;n<3;n++)result.contextBytes=Buffer.byteLength(JSON.stringify(result));if(result.contextBytes>limits.contextBytes)fail('CODE_DATABASE_CONTEXT_LIMIT');await verify(p,value!);return result;
 }
 return {analyzer,status,query};
}
