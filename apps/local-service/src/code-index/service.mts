import {Worker} from 'node:worker_threads';
import {createHmac,randomBytes,timingSafeEqual} from 'node:crypto';
import {extname} from 'node:path';
import {readFile} from 'node:fs/promises';
import {createRequire} from 'node:module';
import type {LocalStore} from '../storage/local-store.mts';
import {safePersistedText} from '../redaction/persisted.mts';
import type {GraphNode,GraphEdge,GraphCoverage,GraphStatus,GraphEdgeType} from '../../../../packages/contracts/graph/code-graph.ts';
import {assertSourceProject,scanCheckedSources,readCheckedSource,digest,graphFail,type SourceProject} from './sources.mts';
import {relatedGraphTasks} from '../impact/service.mts';
const languages:Record<string,string>={'.ts':'ts','.mts':'ts','.cts':'ts','.tsx':'tsx','.js':'js','.mjs':'js','.cjs':'js','.jsx':'jsx'};
const extensions=new Set([...Object.keys(languages),'.py','.go','.rs','.java','.cs','.c','.cpp','.rb','.vue','.svelte']);
const limits={files:1000,bytes:8*1024*1024,fileBytes:512*1024,nodes:25000,edges:50000,workerMs:10000,snapshots:8,depth:3,page:100};
const limitations=['lexical_subset_only','no_type_or_runtime_resolution','imports_and_aliases_unresolved','unsupported_languages_not_indexed','jsx_and_class_semantics_partial','task_matches_bounded_first_1000','memory_only_rebuild_after_restart'];
type Manifest={files:{relativePath:string;hash:string;byteSize:number}[];excluded:string[];parser:string;config:{limits:typeof limits;languages:typeof languages;extensions:string[]}};
type Snapshot={projectId:string;revision:string;manifest:Manifest;nodes:GraphNode[];edges:GraphEdge[];coverage:GraphCoverage[]};
function bounded(params:URLSearchParams,key:string,fallback:number,max:number){const text=params.get(key);if(text===null)return fallback;if(!/^\d+$/.test(text))graphFail('GRAPH_QUERY_INVALID');const n=Number(text);if(n<0||n>max)graphFail('GRAPH_QUERY_INVALID');return n;}
export function createCodeIndex(store:LocalStore){
 const snapshots=new Map<string,Snapshot>(),busy=new Set<string>(),secret=randomBytes(32);
 async function project(id:string){const p=await store.project(id);if(!p)graphFail('PROJECT_NOT_FOUND');return p!;}
 async function inventory(p:SourceProject){const scan=await scanCheckedSources(p,extensions),files=[];let bytes=0;for(const path of scan.files){const file=await readCheckedSource(p,path,limits.fileBytes);bytes+=file.byteSize;if(bytes>limits.bytes)graphFail('GRAPH_SOURCE_LIMIT');files.push(file);}const require=createRequire(new URL('../../../web/package.json',import.meta.url));const implementation=await Promise.all([readFile(new URL('./lexical.mts',import.meta.url)),readFile(new URL('./parser-worker.mts',import.meta.url)),readFile(require.resolve('rolldown/utils')),readFile(require.resolve('rolldown/package.json'))]);return {files,excluded:scan.excluded,parser:digest(Buffer.concat(implementation))};}
 const manifest=(data:Awaited<ReturnType<typeof inventory>>):Manifest=>({files:data.files.map(({relativePath,hash,byteSize})=>({relativePath,hash,byteSize})),excluded:data.excluded,parser:'rolldown-public-utils:'+data.parser,config:{limits,languages,extensions:[...extensions]}});
 const revision=(m:Manifest)=>digest(JSON.stringify(m));
 async function state(p:SourceProject,s:Snapshot){try{return revision(manifest(await inventory(p)))===s.revision?'fresh' as const:'stale' as const;}catch{return 'stale' as const;}}
 function snapshot(id:string,params:URLSearchParams){const s=snapshots.get(id);if(!s)graphFail('GRAPH_INDEX_UNAVAILABLE');const requested=params.get('revision');if(!requested)graphFail('GRAPH_REVISION_REQUIRED');if(requested!==s!.revision)graphFail('GRAPH_REVISION_STALE');return s!;}
 function page<T>(items:T[],id:string,revision:string,params:URLSearchParams){const limit=bounded(params,'limit',50,100);if(limit<1||(params.get('cursor')?.length??0)>2048)graphFail('GRAPH_QUERY_INVALID');const filters=[...params].filter(([k])=>k!=='cursor').sort(([a],[b])=>a.localeCompare(b)),binding=digest(JSON.stringify([id,revision,filters]));let offset=0;
  if(params.has('cursor')){try{const [payload,signature,extra]=params.get('cursor')!.split('.'),expected=createHmac('sha256',secret).update(payload).digest('base64url');if(extra||!signature||signature.length!==expected.length||!timingSafeEqual(Buffer.from(signature),Buffer.from(expected)))graphFail('GRAPH_CURSOR_INVALID');const data=JSON.parse(Buffer.from(payload,'base64url').toString());if(data.binding!==binding||!Number.isSafeInteger(data.offset)||data.offset<0)graphFail('GRAPH_CURSOR_INVALID');offset=data.offset;}catch{graphFail('GRAPH_CURSOR_INVALID');}}
  const selected=items.slice(offset,offset+limit);let nextCursor:null|string=null;if(offset+limit<items.length){const payload=Buffer.from(JSON.stringify({binding,offset:offset+limit})).toString('base64url');nextCursor=payload+'.'+createHmac('sha256',secret).update(payload).digest('base64url');}return {items:selected,nextCursor,total:items.length};
 }
 return {
  async status(id:string):Promise<GraphStatus>{const p=await project(id),s=snapshots.get(id);if(!s){await assertSourceProject(p);return {state:'unavailable',limitations};}return {state:await state(p,s),revision:s.revision,coverage:s.coverage,counts:{files:s.manifest.files.length,nodes:s.nodes.length,edges:s.edges.length},limitations};},
  async rebuild(id:string){if(busy.has(id))graphFail('GRAPH_BUILD_BUSY');if(!snapshots.has(id)&&snapshots.size>=limits.snapshots)graphFail('GRAPH_SNAPSHOT_LIMIT');busy.add(id);try{const p=await project(id),data=await inventory(p),m=manifest(data),rev=revision(m);
   const parsed:any=await new Promise((resolve,reject)=>{const worker=new Worker(new URL('./parser-worker.mts',import.meta.url),{workerData:{files:data.files.filter(f=>languages[extname(f.relativePath)]).map(f=>({...f,language:languages[extname(f.relativePath)]}))},resourceLimits:{maxOldGenerationSizeMb:128}});const timer=setTimeout(()=>{void worker.terminate();reject(Object.assign(Error('GRAPH_BUILD_LIMIT'),{code:'GRAPH_BUILD_LIMIT'}));},limits.workerMs);worker.once('message',v=>{clearTimeout(timer);void worker.terminate();resolve(v);});worker.once('error',()=>{clearTimeout(timer);reject(Object.assign(Error('GRAPH_PARSER_UNAVAILABLE'),{code:'GRAPH_PARSER_UNAVAILABLE'}));});worker.once('exit',code=>{if(code!==0){clearTimeout(timer);reject(Object.assign(Error('GRAPH_PARSER_UNAVAILABLE'),{code:'GRAPH_PARSER_UNAVAILABLE'}));}});});
   if(parsed.error)graphFail(parsed.error);const nodes:GraphNode[]=[],edges:GraphEdge[]=[],coverage:GraphCoverage[]=data.files.filter(f=>!languages[extname(f.relativePath)]).map(f=>({relativePath:f.relativePath,status:'unsupported',reason:'language_not_supported'}));
   for(const r of parsed.results){coverage.push({relativePath:r.relativePath,status:r.status,...(r.reason?{reason:r.reason}:{})});if(r.nodes)nodes.push(...r.nodes);if(r.edges)edges.push(...r.edges);}for(const path of data.excluded)coverage.push({relativePath:path,status:'excluded',reason:'linked_source'});
   if(nodes.length>limits.nodes||edges.length>limits.edges)graphFail('GRAPH_BUILD_LIMIT');if(revision(manifest(await inventory(p)))!==rev)graphFail('GRAPH_SOURCE_DRIFT');await assertSourceProject(p);
   // Publish one complete revision only after validating the entire raw manifest again.
   snapshots.set(id,{projectId:id,revision:rev,manifest:m,nodes,edges,coverage});return this.status(id);
  }finally{busy.delete(id);}},
  async graph(id:string,params:URLSearchParams){const s=snapshot(id,params),p=await project(id),query=(params.get('query')??'').toLowerCase();if(query.length>256)graphFail('GRAPH_QUERY_INVALID');const depth=bounded(params,'depth',1,3),nodeId=params.get('nodeId'),types=(params.get('edgeTypes')??'').split(',').filter(Boolean);if(types.some(t=>!['import','call','define','read','write','reference'].includes(t)))graphFail('GRAPH_QUERY_INVALID');let available=s.nodes.filter(n=>!query||n.name.toLowerCase().includes(query)||n.relativePath.toLowerCase().includes(query));
   const filtered=s.edges.filter(e=>!types.length||types.includes(e.type));let candidateEdges=filtered;
   if(nodeId){if(!s.nodes.some(n=>n.id===nodeId))graphFail('GRAPH_NODE_NOT_FOUND');let reached=new Set([nodeId]),front=new Set([nodeId]);for(let i=0;i<depth;i++){const next=new Set<string>();for(const e of filtered)if(front.has(e.from)||front.has(e.to)){next.add(e.from);next.add(e.to);}for(const n of next)reached.add(n);front=next;}available=available.filter(n=>reached.has(n.id));candidateEdges=filtered.filter(e=>reached.has(e.from)&&reached.has(e.to));}
   // Page primary nodes independently; hydrate only the off-page endpoints of bounded incident edges.
   const result=page(available,id,s.revision,params),visible=new Set(result.items.map(n=>n.id)),incident=candidateEdges.filter(e=>visible.has(e.from)||visible.has(e.to)),edges=incident.slice(0,100),contextIds=new Set(edges.flatMap(e=>[e.from,e.to]).filter(id=>!visible.has(id))),contextNodes=s.nodes.filter(n=>contextIds.has(n.id));return {revision:s.revision,state:await state(p,s),nodes:result.items,contextNodes,edges,nextCursor:result.nextCursor,partial:result.total>result.items.length||incident.length>edges.length};
  },
  async node(id:string,nodeId:string,params:URLSearchParams){const s=snapshot(id,params),node=s.nodes.find(n=>n.id===nodeId);if(!node)graphFail('GRAPH_NODE_NOT_FOUND');return {revision:s.revision,state:await state(await project(id),s),node};},
  async impact(id:string,nodeId:string,params:URLSearchParams){const s=snapshot(id,params),node=s.nodes.find(n=>n.id===nodeId);if(!node)graphFail('GRAPH_NODE_NOT_FOUND');const result=page(s.edges.filter(e=>e.from===nodeId||e.to===nodeId),id+'|impact|'+nodeId,s.revision,params);return {revision:s.revision,state:await state(await project(id),s),node,edges:result.items,nextCursor:result.nextCursor,tasks:await relatedGraphTasks(store,id,node!.relativePath,s.revision,s.manifest.files.find(f=>f.relativePath===node!.relativePath)!.hash),tasksCoverage:'bounded_first_1000'};},
  async source(id:string,params:URLSearchParams){const s=snapshot(id,params),p=await project(id),file=s.nodes.find(n=>n.id===params.get('fileId')&&n.kind==='file');if(!file)graphFail('GRAPH_SOURCE_NOT_FOUND');if(await state(p,s)!=='fresh')graphFail('GRAPH_SOURCE_STALE');const raw=await readCheckedSource(p,file!.relativePath),pin=s.manifest.files.find(f=>f.relativePath===file!.relativePath);if(raw.hash!==pin?.hash)graphFail('GRAPH_SOURCE_STALE');const start=bounded(params,'start',0,raw.text.length),end=bounded(params,'end',Math.min(start+2000,raw.text.length),raw.text.length);if(end<start||end-start>8000)graphFail('GRAPH_QUERY_INVALID');const text=safePersistedText(raw.text),content=text===raw.text?raw.text.slice(start,end):'[redacted source: sensitive content]';return {revision:s.revision,fileId:file!.id,relativePath:file!.relativePath,start,end,sha256:raw.hash,content,redacted:text!==raw.text};}
 };
}
