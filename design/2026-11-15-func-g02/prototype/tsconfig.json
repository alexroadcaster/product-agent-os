{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "react": [
        "../../../apps/web/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "../../../apps/web/node_modules/@types/react/jsx-runtime"
      ],
      "react-dom/client": [
        "../../../apps/web/node_modules/@types/react-dom/client"
      ],
      "d3": [
        "../../../apps/web/node_modules/@types/d3"
      ]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "../../../apps/web/src/vite-env.d.ts"
  ]
}
