{
  "name": "behavioral-workflows",
  "codex_only": true,
  "description": "Prompt and session fixtures for Product-Agent OS route, evidence and approval behavior.",
  "cases": [
    {
      "name": "route-selection",
      "input": {
        "prompt": "Use Product-Agent OS on this existing API repo.",
        "workspace_fixture": "node-app",
        "control_plane_state": "uninitialized"
      },
      "expected": {
        "usage_mode": "standard_feature",
        "route": "workspace-discovery-auditor",
        "write_policy": "read_only",
        "minimum_artifacts": ["workspace audit packet"]
      },
      "forbidden": ["workspace write before audit", "readiness claim without evidence"],
      "residual_risk": "Prompt intent can be ambiguous without workspace signals."
    },
    {
      "name": "methodology-intelligence-read-only-first",
      "input": {
        "prompt": "Audit this workspace with Product-Agent OS methodology intelligence before planning.",
        "workspace_fixture": "node-app",
        "control_plane_state": "uninitialized"
      },
      "expected": {
        "route": "workspace-discovery-auditor",
        "write_policy": "read_only",
        "required_fields": [
          "complexity/maturity classification",
          "Delivery Map",
          "recommendations",
          "questions for owner",
          "no target workspace writes",
          "staged artifacts only after approval"
        ]
      },
      "forbidden": [
        "generating docs without recommendation",
        "claiming readiness from file detection alone",
        "requiring every methodology domain for a simple workspace",
        "activating hooks, automation, CI or external writes"
      ],
      "residual_risk": "Read-only classification can still be incomplete until owner questions and current verification evidence are resolved."
    },
    {
      "name": "first-run-response",
      "input": {
        "prompt": "Start Product-Agent OS here.",
        "workspace_fixture": "empty-repo",
        "control_plane_state": "uninitialized"
      },
      "expected": {
        "usage_mode": "greenfield_idea",
        "first_response_contract": [
          "mode",
          "confidence",
          "next smallest action",
          "minimum artifacts",
          "evidence gaps",
          "approval boundary"
        ],
        "minimum_artifacts": ["greenfield idea brief"]
      },
      "forbidden": ["dump every methodology gate", "scaffold before approval"],
      "residual_risk": "Very small ideas may need a lightweight path."
    },
    {
      "name": "first-run-empty-greenfield",
      "input": {
        "prompt": "Start Product-Agent OS in this empty workspace for a new idea.",
        "workspace_fixture": "empty-repo",
