      },
      "forbidden": [
        "more than one blocking question",
        "scaffold before approval",
        "dump every methodology gate"
      ],
      "residual_risk": "A vague idea may still need one blocking question before the first artifact."
    },
    {
      "name": "first-run-broken-bug-rescue",
      "input": {
        "prompt": "I was vibe coding, got stuck in bugs, and want Product-Agent OS to take over.",
        "workspace_fixture": "failed-verification",
