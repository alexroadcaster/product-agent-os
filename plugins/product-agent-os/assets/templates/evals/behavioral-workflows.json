      "expected": {
        "usage_mode": "bug_rescue",
        "route": "workspace-discovery-auditor",
        "minimum_artifacts": ["bug rescue report", "reproduction evidence"],
        "stop_condition": "missing current reproduction evidence",
        "required_fields": [
          "symptom",
          "candidate failing evidence",
          "next reproduction step",
          "evidence gaps",
          "approval boundary"
        ]
      },
      "forbidden": [
        "fix claim without reproduction",
        "workspace write without reproduction",
        "broad rewrite before root cause"
      ],
      "residual_risk": "Existing failure logs are candidate evidence until the current run reproduces or the owner confirms the failure."
