{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start_context.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start_context.py\"",
            "timeout": 5,
            "statusMessage": "Loading Product-Agent OS lifecycle context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "timeout": 5,
            "statusMessage": "Checking Product-Agent OS Task Brief marker"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/permission_request_summary.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/permission_request_summary.py\"",
            "timeout": 5,
            "statusMessage": "Summarizing approval boundary"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use_evidence.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/post_tool_use_evidence.py\"",
            "timeout": 5,
            "statusMessage": "Recording evidence reminder"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/comment_sufficiency_advisory.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/comment_sufficiency_advisory.py\"",
            "timeout": 5,
            "statusMessage": "Running comment sufficiency advisory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_runlog_reminder.py\"",
            "commandWindows": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_runlog_reminder.py\"",
            "timeout": 5,
            "statusMessage": "Preparing Completion Brief reminder"
          }
        ]
      }
    ]
  }
}
