  "implemented_hardening": {
    "module": "plugins/product-agent-os/scripts/codex_runtime_runner/model_output.py",
    "tests": "tests/product_agent_os/test_codex_runtime_runner_model_output.py",
    "strict_final_json_parser": {
      "marker": "FINAL_JSON:",
      "method": "json.JSONDecoder().raw_decode after a single explicit marker",
      "rejects": [
        "missing marker",
        "multiple markers",
        "invalid JSON including unescaped nested quotes",
        "trailing non-whitespace content",
        "non-object final payload"
      ],
      "repair_policy": "no repair or best-effort JSON reconstruction"
    },
    "run_schema_contract": {
      "allowed_statuses": [
        "completed",
        "timeout",
        "no_op",
        "invalid_json",
        "wrapper_failure_before_model_call",
        "aborted_by_policy",
        "not_run_due_stop_rule"
      ],
      "required_fields": [
        "task_id",
        "arm",
        "pair_id",
        "attempt_id",
        "status",
        "timed_out",
        "final_json_parse_ok",
        "changed_file_count",
        "sanitized_changed_files",
        "behavior_score",
        "raw_output_hashes",
        "retention_status"
      ],
      "raw_retention_required": "raw_temp_only_repo_sanitized_rollup"
    },
    "no_op_guard": {
      "completed_requires_material_change_when_material_change_required": true,
      "ignored_change_evidence": [
        "__pycache__",
        ".pyc",
        "tmp_root_write_check.txt",
        "copy/setup/watchdog/process probe logs"
      ],
      "no_op_runs_are_invalid_for_pair_scoring": true
    },
    "pair_gate_contract": {
      "valid_pair_requires_baseline_completed_and_treatment_completed": true,
      "invalid_reason_style": "arm_specific_status_reason",
      "supported_t12_reasons": [
        "treatment_invalid_json",
        "treatment_no_op"
      ],
      "invalid_pairs_enter_scoring": false
    },
    "aggregate_gate_contract": {
      "valid_pair_count_required_for_reviewer": 8,
      "reviewer_status_when_invalid_pairs_exist": "not_run_due_invalid_pair_count",
      "promotion_threshold_met_when_invalid_pairs_exist": false,
      "m26_reversed_when_invalid_pairs_exist": false,
      "m35_reversed_when_invalid_pairs_exist": false
    },
    "privacy_retention_contract": {
      "validate_serialized_rollup_redaction": true,
      "forbid_sensitive_dict_keys": true,
      "forbid_raw_output_body_fields": true,
      "allow_hashes_and_lengths_only": true,
      "concrete_temp_root_in_repo_allowed": false
    }
