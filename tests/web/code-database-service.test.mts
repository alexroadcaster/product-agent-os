import {test} from 'node:test';
import assert from 'node:assert/strict';
import {mkdir,readFile,writeFile,rename} from 'node:fs/promises';
import {performance} from 'node:perf_hooks';
import {join} from 'node:path';
import {m2Fixture} from './m2-fixture.mts';
import {bindProject} from '../../apps/local-service/src/adapters/project-sources.ts';
import {inventoryForProject} from '../../apps/local-service/src/code-index/sources.mts';
import {createCodeDatabase} from '../../apps/local-service/src/code-database/service.mts';
const corpus=JSON.parse(await readFile(new URL('../fixtures/func_g04/code-database/corpus.json',import.meta.url),'utf8'));
test('SQLite table names matching JavaScript prototype keys retain string test candidates after persistence and restart',async t=>{
 const f=await fixture(t),names=['__proto__','constructor','toString'];
 await writeFile(join(f.workspace,'queries/prototype.sql'),names.map(name=>`SELECT * FROM "${name}";`).join('\n'));
 await writeFile(join(f.workspace,'tests/prototype.test.ts'),`// static table mentions: ${names.join(' ')}`);
 const snapshot=f.deps.databaseMap.snapshot;f.deps.databaseMap.snapshot=async()=>({...await snapshot(),tables:[...corpus.tables,...names].map(name=>({name}))});
 f.context.inventory=await inventoryForProject(f.project).snapshot(f.project);
 await f.service.analyzer(f.context);
 const persisted=(await f.store.readProjectState('q','project_code_database_v1'))!.value as any;
 for(const name of names){
  assert.ok(Object.hasOwn(persisted.candidates,name),`candidate dictionary must own ${name}`);
  const page=await createCodeDatabase(f.deps).query('q',new URLSearchParams({table:name,codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'}));
  assert.ok(page.links.length>0);assert.deepEqual(page.testCandidates,[{relativePath:'tests/prototype.test.ts',reason:'literal_table_mention_static_candidate_not_execution_proof'}]);
 }
 const row=(await f.store.readProjectState('q','project_code_database_v1'))!;
 await f.store.writeProjectState('q','project_code_database_v1',row.version,{...persisted,candidates:[]});
 await assert.rejects(f.service.status('q'),{code:'CODE_DATABASE_STATE_UNAVAILABLE'});
});
async function fixture(t:any){const base=await m2Fixture(t),workspace=join(base.root,'workspace');await mkdir(workspace);for(const f of corpus.files){const path=join(workspace,f.relativePath);await mkdir(join(path,'..'),{recursive:true});await writeFile(path,f.content);}await writeFile(join(workspace,'app.sqlite'),'synthetic metadata source placeholder, never opened');const pin=await bindProject('q',workspace);await base.store.registerProject({id:'q',keyPrefix:'QWER',canonicalRoot:pin.workspaceRoot,rootIdentity:pin.directoryIdentity,authorityMode:'sql'});const project=(await base.store.project('q'))!,inventory=await inventoryForProject(project).snapshot(project);const dynamic={codeRevision:'code-rev-a',schemaRevision:'schema-rev-a',sourcePath:'app.sqlite',schemaState:'ready',codeState:'fresh',version:1};
 const deps={store:base.store,codeIndex:{status:async()=>({state:dynamic.codeState,revision:dynamic.codeRevision})},databaseMap:{status:async()=>({state:dynamic.schemaState,version:dynamic.version,snapshotRevision:dynamic.schemaRevision,source:{relativePath:dynamic.sourcePath}}),snapshot:async()=>({state:'current',snapshot:{projectId:'q',rootIdentity:project.rootIdentity,policyVersion:inventory.policyVersion,revision:dynamic.schemaRevision,relativePath:dynamic.sourcePath},tables:corpus.tables.map((name:string)=>({name})),nextCursor:null})}};const controller=new AbortController();let publish=true;const context={project,inventory,signal:controller.signal,publicationGuard:async()=>{},canPublish:()=>publish,onProgress:async()=>{}};return {...base,workspace,project,inventory,deps,dynamic,controller,context,cancel:()=>{publish=false;},service:createCodeDatabase(deps)};}
test('bounded production service publishes corpus and source-backed agent query pins both revisions',async t=>{const f=await fixture(t),result=await f.service.analyzer(f.context);assert.ok(['completed','partial'].includes(result.state));assert.ok(Number((result.data?.metrics as any)?.parserMaxRssKiB)>0);const persisted=await f.store.readProjectState('q','project_code_database_v1');assert.ok(!Object.hasOwn(persisted!.value as object,'metrics'));const status=await f.service.status('q');assert.ok(['fresh','partial'].includes(status.state));const page=await f.service.query('q',new URLSearchParams({table:'users',confidence:'confirmed',limit:'1',codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'}));assert.equal(page.links.length,1);assert.ok(page.links.every((x:any)=>x.table==='users'&&x.confidence==='confirmed'));assert.ok(page.nextCursor);assert.ok(page.testCandidates.some((x:any)=>x.relativePath==='tests/users.test.ts'));assert.ok(Buffer.byteLength(JSON.stringify(page))<=32768);});

test('late cancellation, selection drift and SQL source/policy changes cannot publish a late snapshot',async t=>{for(const mode of ['cancel','selection','selection-version','file','policy']){const f=await fixture(t);f.context.publicationGuard=async()=>{if(mode==='cancel')f.cancel();else if(mode==='selection')f.dynamic.schemaRevision='schema-rev-b';else if(mode==='selection-version')f.dynamic.version++;else if(mode==='file')await writeFile(join(f.workspace,'queries/migration.sql'),'SELECT * FROM users;');else await f.store.writeProjectState('q','project_inventory_policy_v1',0,{schemaVersion:'paos_inventory_policy_v1',policy:{exclude:['src/native.ts']}});};await assert.rejects(f.service.analyzer(f.context),(error:any)=>/CANCELLED|STALE|NOT_CURRENT/.test(error.code));assert.equal(await f.store.readProjectState('q','project_code_database_v1'),null);}});

test('cursor filters/project/revisions stay scoped; restart preserves record pins but invalidates ephemeral cursors',async t=>{const f=await fixture(t);await f.service.analyzer(f.context);const parameters={table:'users',confidence:'confirmed',limit:'1',codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'},first=await f.service.query('q',new URLSearchParams(parameters));await assert.rejects(f.service.query('q',new URLSearchParams({...parameters,table:'orders',cursor:first.nextCursor!})),{code:'CODE_DATABASE_CURSOR_STALE'});const restarted=createCodeDatabase(f.deps);assert.ok(['fresh','partial'].includes((await restarted.status('q')).state));await assert.rejects(restarted.query('q',new URLSearchParams({...parameters,cursor:first.nextCursor!})),{code:'CODE_DATABASE_CURSOR_INVALID'});f.dynamic.codeState='unavailable';assert.equal((await restarted.status('q')).state,'stale');await assert.rejects(restarted.query('q',new URLSearchParams(parameters)),{code:'CODE_DATABASE_CODE_NOT_CURRENT'});f.dynamic.codeState='fresh';f.dynamic.schemaRevision='schema-rev-b';await assert.rejects(f.service.query('q',new URLSearchParams(parameters)),{code:'CODE_DATABASE_REVISION_STALE'});});

test('SQL source rename/drop invalidates retained links instead of presenting an empty impact',async t=>{const f=await fixture(t);await f.service.analyzer(f.context);await rename(join(f.workspace,'queries/migration.sql'),join(f.workspace,'queries/renamed.sql'));assert.equal((await f.service.status('q')).state,'stale');await assert.rejects(f.service.query('q',new URLSearchParams({codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'})),{code:'CODE_DATABASE_SOURCE_STALE'});});

test('unselected schema and pre-cancelled scan remain bounded unavailable/cancelled without changing target bytes',async t=>{const f=await fixture(t);f.dynamic.schemaState='unselected';const unavailable=await f.service.analyzer(f.context);assert.equal(unavailable.state,'unavailable');assert.ok(unavailable.reasons?.includes('CODE_DATABASE_SCHEMA_NOT_CURRENT'));f.dynamic.schemaState='ready';f.controller.abort();await assert.rejects(f.service.analyzer(f.context),{code:'CODE_DATABASE_CANCELLED'});assert.equal(await f.store.readProjectState('q','project_code_database_v1'),null);for(const file of corpus.files)assert.equal(await readFile(join(f.workspace,file.relativePath),'utf8'),file.content);assert.equal(await readFile(join(f.workspace,'app.sqlite'),'utf8'),'synthetic metadata source placeholder, never opened');});

test('oversized source is explicit partial while accepted files and all original bytes remain intact',async t=>{const f=await fixture(t),large='x'.repeat(524289);await writeFile(join(f.workspace,'src/large.ts'),large);f.context.inventory=await inventoryForProject(f.project).snapshot(f.project);const result=await f.service.analyzer(f.context);assert.equal(result.state,'partial');assert.ok(result.reasons?.some(reason=>reason.startsWith('file_byte_limit:')));const page=await f.service.query('q',new URLSearchParams({table:'users',confidence:'confirmed',codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'}));assert.ok(page.links.length>0);assert.equal(await readFile(join(f.workspace,'src/large.ts'),'utf8'),large);for(const file of corpus.files)assert.equal(await readFile(join(f.workspace,file.relativePath),'utf8'),file.content);});

test('large link pages remain within 32KiB and traverse every selected link exactly once',async t=>{const f=await fixture(t);await writeFile(join(f.workspace,'src/bulk.ts'),"import {DatabaseSync} from 'node:sqlite';\nconst db=new DatabaseSync(new URL('../app.sqlite',import.meta.url));\n"+Array.from({length:400},()=>"db.prepare('SELECT * FROM users');").join('\n'));f.context.inventory=await inventoryForProject(f.project).snapshot(f.project);await f.service.analyzer(f.context);const parameters={table:'users',confidence:'confirmed',limit:'100',codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'},ids=new Set<string>();let cursor:string|null=null,total=0,pages=0;do{const page=await f.service.query('q',new URLSearchParams({...parameters,...(cursor?{cursor}:{})}));const bytes=Buffer.byteLength(JSON.stringify(page));assert.ok(bytes<=32768);assert.equal(page.contextBytes,bytes);assert.ok(page.links.length>0);for(const link of page.links){assert.ok(!ids.has(link.id));ids.add(link.id);}cursor=page.nextCursor;total=page.total;assert.ok(++pages<30);}while(cursor);assert.equal(ids.size,total);assert.ok(total>=400);});

test('agreed static-search tasks record actual precision/recall, context and elapsed comparison without human-time claims',async t=>{const f=await fixture(t),buildAt=performance.now();await f.service.analyzer(f.context);const buildMs=performance.now()-buildAt,tasks=[];for(const task of corpus.comparisonTasks){const at=performance.now(),baseline=corpus.files.filter((file:any)=>file.content.toLowerCase().includes(task.table.toLowerCase())),baselineMs=performance.now()-at,queryAt=performance.now(),page=await f.service.query('q',new URLSearchParams({table:task.table,confidence:'confirmed',limit:'100',codeRevision:'code-rev-a',schemaRevision:'schema-rev-a'})),queryMs=performance.now()-queryAt,found=[...new Set(page.links.map((link:any)=>link.relativePath))].sort(),expected=[...task.confirmedFiles].sort();assert.deepEqual(found,expected);assert.deepEqual(page.testCandidates.map((candidate:any)=>candidate.relativePath),task.staticTestCandidates);tasks.push({table:task.table,expectedFiles:expected,literalStringSearchFiles:baseline.map((file:any)=>file.relativePath),baselineMissingFiles:expected.filter((path:string)=>!baseline.some((file:any)=>file.relativePath===path)),baselineExtraFiles:baseline.filter((file:any)=>!expected.includes(file.relativePath)).map((file:any)=>file.relativePath),linkedFiles:found,missingLinkedFiles:expected.filter((path:string)=>!found.includes(path)),extraLinkedFiles:found.filter(path=>!expected.includes(path)),baselineContextBytes:baseline.reduce((sum:number,file:any)=>sum+Buffer.byteLength(file.content),0),queryContextBytes:page.contextBytes,baselineMilliseconds:baselineMs,queryMilliseconds:queryMs,testCandidates:page.testCandidates});}const output={schemaVersion:'paos_code_database_evaluation_v1',observedAt:new Date().toISOString(),provenance:'real F28 checked sources and LocalStore; synthetic schema/code-status adapters; automated string-search proxy, not human performance',buildMilliseconds:buildMs,tasks};const root=new URL('../../.tmp/func-g04/code-database/',import.meta.url);await mkdir(root,{recursive:true});await writeFile(new URL('evaluation-'+Date.now()+'.json',root),JSON.stringify(output,null,2));});
