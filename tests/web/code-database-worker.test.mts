import {test} from 'node:test';
import assert from 'node:assert/strict';
import {performance} from 'node:perf_hooks';
import {mkdir,writeFile} from 'node:fs/promises';
import {runCodeDatabaseAnalysis} from '../../apps/local-service/src/code-database/runner.mts';
const options={sourcePath:'app.sqlite',tables:['users'],codeRevision:'code-fixture',schemaRevision:'schema-fixture'};
const huge=[{relativePath:'large.ts',text:'export const object={'+Array.from({length:65000},(_,i)=>'p'+i+':0').join(',')+'};'}];
test('actual owned child wall deadline rejects independently of parser/AST completion',async()=>{const files=[{relativePath:'large.ts',text:'export const object={'+Array.from({length:40000},(_,i)=>'p'+i+':0').join(',')+'};'}],at=performance.now();await assert.rejects(runCodeDatabaseAnalysis(files,options,{milliseconds:1}),{code:'CODE_DATABASE_WORKER_TIMEOUT'});assert.ok(performance.now()-at<2000);});
test('actual owned child abort terminates analysis without a successful late result',async()=>{const controller=new AbortController();let online=0;const at=performance.now();await assert.rejects(runCodeDatabaseAnalysis([{relativePath:'deep.ts',text:'const x='+'('.repeat(12000)+'0'+')'.repeat(12000)+';'}],options,{signal:controller.signal,onChildStarted:()=>{online++;controller.abort();}}),{code:'CODE_DATABASE_CANCELLED'});assert.equal(online,1);assert.ok(performance.now()-at<2000);});
test('pathological deep/large/native-recursive inputs stay contained in an owned child',async()=>{const inputs=[[{relativePath:'deep.ts',text:'const x='+'('.repeat(12000)+'0'+')'.repeat(12000)+';'}],huge.map(f=>({...f,text:f.text.slice(0,524280)})),[{relativePath:'unary.ts',text:'const x='+'!'.repeat(12000)+'false;'}],[{relativePath:'arrows.ts',text:'const f='+'()=>'.repeat(12000)+'0;'}]],observations=[];for(const files of inputs){const at=performance.now();try{const result=await runCodeDatabaseAnalysis(files,options);assert.ok(result.reasons.some(reason=>/parse_unavailable|ast_limit|source_depth_limit/.test(reason)));assert.ok(result.links.length<=1000);assert.ok(Buffer.byteLength(JSON.stringify(result))<=1024*1024);observations.push({relativePath:files[0].relativePath,outcome:'bounded_partial',reasons:result.reasons,milliseconds:performance.now()-at});}catch(error){assert.ok(['CODE_DATABASE_WORKER_MEMORY','CODE_DATABASE_PARSER_UNAVAILABLE','CODE_DATABASE_WORKER_TIMEOUT'].includes((error as any).code));observations.push({relativePath:files[0].relativePath,outcome:'contained_child_failure',code:(error as any).code,childExitCode:(error as any).childExitCode??null,milliseconds:performance.now()-at});}assert.ok(performance.now()-at<12000);}const root=new URL('../../.tmp/func-g04/code-database/',import.meta.url);await mkdir(root,{recursive:true});await writeFile(new URL('child-containment-'+Date.now()+'.json',root),JSON.stringify({schemaVersion:'paos_code_database_child_containment_v1',observations},null,2));});
