 await page.waitForFunction(()=>document.querySelector('[data-testid="mermaid-panel"]')?.getAttribute('data-mermaid-support')!=='pending');const erSupport=await page.getByTestId('mermaid-panel').getAttribute('data-mermaid-support');if(erSupport==='supported'){assert.match(await page.locator('[data-testid="mermaid-panel"] svg').first().textContent(),/self_node/);}checks.push({name:'tiny ER runtime probe',passed:true,result:erSupport==='unsupported'?'unsupported_with_explicit_local_svg_fallback':'canonical_er_rendered'});
