 await check('direct URL project B cannot read A sources or export A schema',async()=>{await go('?project=b&route=source&selected=src/main.ts');assert.match(await page.getByTestId('source-code').innerText(),/Source unavailable/);assert.ok(!(await page.getByTestId('source-code').innerText()).includes('import'));await go('?project=b&route=files&selected=src/main.ts');assert.equal(await page.locator('.poc-file-list button').count(),0);await go('?project=b&route=database&engine=f32');assert.ok(await page.getByTestId('export-mermaid').isDisabled());assert.equal(JSON.parse(await ids()).length,0);await go('?route=database&engine=f32');});
 await check('project isolation / URL restoration',async()=>{await page.getByLabel('Project',{exact:true}).selectOption('b');assert.equal(new URL(page.url()).searchParams.get('selected'),null);assert.equal(JSON.parse(await ids()).length,0);await page.reload();await page.getByTestId('poc-app').waitFor();assert.equal(await page.getByLabel('Project',{exact:true}).inputValue(),'b');await page.getByLabel('Project',{exact:true}).selectOption('a');await page.locator('[data-route="map"]').click();await page.locator('[data-view="list"]').click();});
 await check('all synthetic lifecycle states and recovery',async()=>{await page.locator('.poc-state-control summary').click();for(const phase of ['loading','empty','partial','error','unavailable','stale']){await page.getByLabel('Fixture state',{exact:true}).selectOption(phase);assert.equal(new URL(page.url()).searchParams.get('phase'),phase);if(phase==='loading')await page.getByRole('button',{name:'Отмена UI fixture',exact:true}).click();else if(phase==='empty')await page.getByTestId('empty').waitFor();else if(phase==='stale'){await page.locator('[data-row-id="src/main.ts"] button').click();assert.ok(await page.getByTestId('open-source').isDisabled());}else await page.getByRole('button',{name:'Повторить UI fixture',exact:true}).click();}await page.getByLabel('Fixture state',{exact:true}).selectOption('ready');});
 await check('Files source and navigation',async()=>{await page.locator('[data-route="files"]').click();await page.getByRole('button',{name:'src/main.ts',exact:true}).click();await page.getByTestId('source-back').click();assert.equal(new URL(page.url()).searchParams.get('route'),'files');await page.locator('[data-route="map"]').click();});
 for(const locale of ['ru','en'])for(const theme of ['light','dark'])await check(`${locale}/${theme} desktop + mobile readability`,async()=>{await page.getByLabel('Language',{exact:true}).selectOption(locale);await page.getByLabel('Theme',{exact:true}).selectOption(theme);for(const width of [1440,390]){await page.setViewportSize({width,height:1000});await page.locator('[data-view="list"]').click();assert.equal(await page.locator('html').getAttribute('lang'),locale);assert.equal(await page.locator('html').getAttribute('data-theme'),theme);const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth+2);assert.equal(overflow,false);const header=await page.locator('.poc-header').boundingBox(),nav=await page.locator('.poc-nav').boundingBox();assert.ok(header.y+header.height<=nav.y+1,'header must not overlap navigation');await page.locator('[data-row-id="src/main.ts"] button').click();assert.ok(await page.getByTestId('inspector').isVisible());await page.screenshot({path:resolve(out,`${locale}-${theme}-${width}.png`),fullPage:true});}});
 await page.setViewportSize({width:844,height:390});await page.screenshot({path:resolve(out,'landscape.png'),fullPage:true});
