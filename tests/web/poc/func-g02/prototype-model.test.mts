import test from 'node:test';import assert from 'node:assert/strict';
import {defaults,decode,encode,switchProject,visible,pathEdges,highlight,flowchart,contractFixture,projectSources,schemaMermaid} from '../../../../design/2026-11-15-func-g02/prototype/model.ts';
const snapshot={meta:{} as any,nodes:['a','b','c'].map(id=>({id,kind:'file',name:id,relativePath:id+'.ts',line:1})),edges:[{id:'ab',from:'a',to:'b',type:'import',relativePath:'a.ts',line:1,resolution:'resolved'},{id:'ba',from:'b',to:'a',type:'import',relativePath:'b.ts',line:1,resolution:'resolved'},{id:'bc',from:'b',to:'c',type:'import',dynamic:true,relativePath:'b.ts',line:2,resolution:'resolved'}]};
test('URL state round-trips Unicode selection while malformed modes retain safe defaults',()=>{const state={...defaults,selected:'имя с пробелом.ts',query:'data',view:'graph'};assert.deepEqual(decode(encode(state)),state);assert.equal(decode('?route=unsafe&theme=purple').route,'map');});
test('project switching clears incompatible selections, path target and filters',()=>{const state=switchProject({...defaults,selected:'a',target:'b',query:'x',phase:'stale',focus:'path'},'b');assert.equal(state.selected,'');assert.equal(state.target,'');assert.equal(state.query,'');assert.equal(state.phase,'ready');});
test('incoming/outgoing and edge-type filters return one consistent bounded graph',()=>{assert.deepEqual(visible(snapshot,{...defaults,selected:'b',direction:'incoming'}).edges.map(e=>e.id),['ab']);assert.deepEqual(visible(snapshot,{...defaults,type:'dynamic'}).edges.map(e=>e.id),['bc']);});
test('cycle, path and impact distinguish edge direction and unreachable targets',()=>{assert.deepEqual([...highlight(snapshot.edges,{...defaults,focus:'cycle'})].sort(),['ab','ba']);assert.deepEqual([...pathEdges(snapshot.edges,'a','c')],['bc','ab']);assert.equal(pathEdges(snapshot.edges,'c','a').size,0);assert.ok(highlight(snapshot.edges,{...defaults,focus:'impact',selected:'c'}).has('bc'));});
test('Mermaid syntax uses generated IDs and escaped source labels, not raw markup',()=>{const source=flowchart([{id:'x',kind:'file',name:'<script>"',relativePath:'x',line:1}],[]);assert.ok(source.includes('n0['));assert.ok(!source.includes('<script>'));});
test('proposed call fixture explicitly identifies unmeasured provenance and never claims CBM engine identity',()=>{const fixture=contractFixture();assert.ok(fixture.meta.engine.includes('NOT CBM output'));assert.equal(fixture.meta.coverage.status,'contract_fixture');assert.equal(fixture.edges[0].resolution,'ground_truth_fixture');});

test('source boundary never exposes project A files in empty project B',()=>{assert.deepEqual(projectSources('b',{'src/main.ts':'private A source'}),{});assert.equal(projectSources('a',{'src/main.ts':'fixture'})['src/main.ts'],'fixture');});
test('canonical schema follows filtered nodes and contained declared edges',()=>{const schema={...snapshot,nodes:[{...snapshot.nodes[0],kind:'table'}],edges:[],tables:[{name:'a',columns:[{name:'id',type:'INTEGER',primaryKeyPosition:1}]},{name:'b',columns:[]}]};const source=schemaMermaid(schema);assert.match(source,/a \{/);assert.ok(!source.includes('b {'));assert.ok(!source.includes('declared_FK'));});
