async function hashes(root:string,prefix=''):Promise<Record<string,string>>{const result:Record<string,string>={};for(const e of await readdir(join(root,prefix),{withFileTypes:true})){const path=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())Object.assign(result,await hashes(root,path));else if(e.isFile())result[path]=sha(await readFile(join(root,path)));}return result;}
async function bindings(){const result:Record<string,string>={};for(const root of ['apps/web/src','apps/local-service/src','packages/contracts'])for(const [path,value] of Object.entries(await hashes(resolve(root))))result[root+'/'+path]=value;for(const path of ['apps/web/package-lock.json','tests/fixtures/func_g04/protocol.json','tests/web/single-window/graph-database-browser-acceptance.mts'])result[path]=sha(await readFile(path));return result;}
