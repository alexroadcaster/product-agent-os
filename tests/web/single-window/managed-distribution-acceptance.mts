async function hashes(directory:string,prefix=''):Promise<Record<string,string>>{const result:Record<string,string>={};for(const e of await readdir(join(directory,prefix),{withFileTypes:true})){const name=prefix?prefix+'/'+e.name:e.name;if(e.isDirectory())Object.assign(result,await hashes(directory,name));else{const info=await lstat(join(directory,name));assert.ok(info.isFile()&&!info.isSymbolicLink());result[name]=sha(await readFile(join(directory,name)));}}return result;}
/** SQLite read-only WAL connections may create derived bookkeeping. Never ignore an original file or sidecar. */
