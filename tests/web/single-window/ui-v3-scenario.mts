import {captureV3States} from './v3-state-capture.mts';
import {mkdir,writeFile} from 'node:fs/promises';
import {join} from 'node:path';
import {auditRenderedPage} from '../accessibility/audit.mts';
import {uiLabel} from '../../../apps/web/src/locales/messages.ts';
/** Reuses the M2c disposable service/browser fixture; all values below are synthetic. */
export async function runUiV3({page,api,project,base,taskId,workspace,store,report,check,until,shot}:any){
 const nav=async(id:string,locale='ru')=>page.locator('.navigation nav').getByRole('button',{name:id==='portfolio'?(locale==='ru'?'Все проекты':'All projects'):['search','import','backup'].includes(id)?({search:locale==='ru'?'Поиск':'Search',import:locale==='ru'?'Импорт':'Import',backup:locale==='ru'?'Резервная копия':'Backup'} as any)[id]:uiLabel(locale as any,('nav.'+id) as any),exact:true}).click();
 const appearance=async(locale:string,theme:string)=>{const old=await page.locator('html').getAttribute('lang');await nav('settings',old);await page.locator('[data-settings-section=general]').click();await page.getByLabel(uiLabel(old as any,'preferences.language'),{exact:true}).selectOption(locale);await page.getByLabel(uiLabel(old as any,'preferences.theme'),{exact:true}).selectOption(theme);await page.getByRole('button',{name:uiLabel(old as any,'preferences.save'),exact:true}).click();await until('appearance_'+locale+theme,async()=>await page.locator('html').getAttribute('lang')===locale&&await page.locator('html').getAttribute('data-theme')===theme);};
 await mkdir(join(workspace,'feature'));await writeFile(join(workspace,'feature','module.ts'),'export const $foo = 1;\nexport function dollar(){return $foo;}\n');
 await page.reload();await page.locator('.navigation select:enabled').waitFor();await page.locator('.navigation select').selectOption(project.id);
 check('all_fifteen_destinations',await page.locator('.navigation nav button').count()===15);
 await nav('overview');await until('project_summary_loaded',async()=>await page.getByTestId('project-dashboard').locator('.dashboard-progress-summary span:last-of-type strong').first().innerText()==='1');check('real_task_count',await page.getByTestId('project-dashboard').locator('.dashboard-progress-summary span:last-of-type strong').first().innerText()==='1');check('d3_chart_active',await page.locator('[data-renderer=d3-scale]').count()>0);check('usage_unknown',await page.locator('.ui-usage').first().innerText().then((s:string)=>s.includes('Нет данных')));
 await page.locator('.sidebar-toggle').click();await until('sidebar_64',async()=>Math.abs((await page.locator('.navigation').boundingBox()).width-64)<.1);await nav('agents');check('collapsed_survives_navigation',await page.locator('.sidebar-toggle').getAttribute('aria-expanded')==='false');await page.locator('.navigation nav button').last().focus();await page.getByRole('tooltip').waitFor();await page.keyboard.press('Escape');check('tooltip_escape',await page.getByRole('tooltip').count()===0);await page.locator('.sidebar-toggle').click();await until('sidebar_216',async()=>Math.abs((await page.locator('.navigation').boundingBox()).width-216)<.1);
 await page.emulateMedia({reducedMotion:'reduce'});await page.locator('.sidebar-toggle').click();await until('reduced_collapsed',async()=>Math.abs((await page.locator('.navigation').boundingBox()).width-64)<.1);await page.locator('.sidebar-toggle').click();await until('reduced_expanded',async()=>Math.abs((await page.locator('.navigation').boundingBox()).width-216)<.1);await page.emulateMedia({reducedMotion:'no-preference'});
 await nav('projectMap');const graph=page.getByTestId('graph-explorer');await graph.getByTestId('graph-rebuild').click();await until('v3_graph_fresh',async()=>(await api(base+'/graph/status')).body.state==='fresh');await until('d3_nodes',async()=>await graph.locator('[data-renderer=d3-force] [role=button]').count()>0);const count=await graph.locator('[data-renderer=d3-force] [role=button]').count();await graph.getByRole('button',{name:'Mermaid',exact:true}).click();await until('mermaid_svg',async()=>await graph.locator('[data-renderer=mermaid] svg').count()===1,30000);check('renderers_same_node_count',await graph.locator('[data-renderer=mermaid] svg g.node').count()===count);await graph.getByRole('button',{name:'100%',exact:true}).click();await until('mermaid_readable_labels',async()=>await graph.locator('[data-renderer=mermaid] svg text').first().evaluate((el:Element)=>el.getBoundingClientRect().height>=12));const beforeZoom=await graph.locator('[data-renderer=mermaid] svg').boundingBox();await graph.getByRole('button',{name:'Увеличить схему',exact:true}).click();await until('mermaid_zoom_changes_geometry',async()=>(await graph.locator('[data-renderer=mermaid] svg').boundingBox()).width>beforeZoom.width);await graph.getByRole('button',{name:'100%',exact:true}).click();await shot('v3-mermaid-light.png');await graph.locator('.graph-filter-panel>summary').click();await graph.locator('[name=graph-query]').fill('$foo');await graph.getByTestId('graph-filters').getByRole('button',{name:'Применить фильтры',exact:true}).click();await until('mermaid_special_identifier',async()=>await graph.locator('[data-renderer=mermaid] svg').textContent().then((s:string|null)=>(s??'').includes('$foo')));check('mermaid_exact_label',await graph.locator('[data-renderer=mermaid] svg').textContent().then((s:string|null)=>(s??'').includes('$foo')));await graph.locator('[name=graph-query]').fill('');const allReply=page.waitForResponse((r:any)=>r.url().includes('/graph?')&&new URL(r.url()).searchParams.get('query')==='');await graph.getByTestId('graph-filters').getByRole('button',{name:'Применить фильтры',exact:true}).click();await allReply;await until('whole_page_reloaded',async()=>await graph.locator('[data-graph-node]').count()>3);await until('graph_module_available',async()=>(await graph.getByLabel('Модуль карты',{exact:true}).locator('option').allTextContents()).includes('feature'));await graph.getByLabel('Модуль карты',{exact:true}).selectOption('feature');await until('mermaid_module_ready',async()=>await graph.locator('[data-renderer=mermaid]').getAttribute('aria-busy')==='false'&&await graph.locator('[data-renderer=mermaid] svg g.node').count()===Math.min(100,await graph.locator('[data-graph-node]').count()));const moduleCount=await graph.locator('[data-renderer=mermaid] svg g.node').count();await graph.getByRole('button',{name:'Граф',exact:true}).click();check('module_renderers_match',await graph.locator('[data-renderer=d3-force] [role=button]').count()===moduleCount,{mermaid:moduleCount,d3:await graph.locator('[data-renderer=d3-force] [role=button]').count()});await graph.getByLabel('Модуль карты',{exact:true}).selectOption('');await graph.locator('.graph-filter-panel>summary').click();await graph.getByRole('button',{name:'Граф',exact:true}).click();await shot('v3-graph-light.png');
 report.views=[];const routes=['portfolio','overview','tasks','sessions','agents','skills','projectMap','documents','checks','autonomy','decisions','search','import','backup','settings'];
 for(const locale of ['ru','en'])for(const theme of ['light','dark']){await appearance(locale,theme);for(const route of routes){await nav(route,locale);await page.evaluate(()=>new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r))));for(const width of locale==='ru'?[1280,1440,1920]:[1440]){await page.setViewportSize({width,height:1000});const result=await page.evaluate(auditRenderedPage);report.views.push({locale,theme,route,...result});check('contrast_'+locale+theme+route+width,result.findings.length===0,result.findings);check('geometry_'+locale+theme+route+width,result.geometry.scroll<=result.geometry.width+1,result.geometry);if(width===1440)await shot('v3-'+locale+'-'+theme+'-'+route+'.png');}}
  await nav('tasks',locale);await page.locator('[data-task-id="'+taskId+'"]').first().dblclick();const detail=page.getByTestId('task-detail');for(const tab of await detail.getByRole('tab').all()){await tab.click();check('task_tab_'+locale+theme+await tab.innerText(),await detail.getByRole('tabpanel').isVisible());}await shot('v3-'+locale+'-'+theme+'-task-overlay.png');await page.keyboard.press('Escape');
  await nav('settings',locale);for(const tab of await page.getByTestId('settings-navigation').getByRole('tab').all()){await tab.click();check('settings_tab_'+locale+theme+await tab.innerText(),await page.locator('.settings-local-panel:visible').count()>0);}await page.locator('[data-settings-section=processes]').click();for(const tab of await page.getByTestId('workflow-navigation').getByRole('tab').all()){await tab.click();check('workflow_tab_'+locale+theme+await tab.innerText(),await page.getByTestId('workflow-manager').isVisible());}await page.locator('[data-workflow-section=states]').click();await shot('v3-'+locale+'-'+theme+'-workflow.png');
 }
 await captureV3States({page,api,project,base,taskId,store,shot,report,nav,appearance});
 check('all_170_product_states_captured',report.stateViews.length===170&&report.stateViews.every((v:any)=>v.status==='captured'),report.stateViews.filter((v:any)=>v.status!=='captured'));
 check('all_product_state_geometry_and_contrast',report.stateViews.every((v:any)=>!v.audit.findings.length&&v.audit.geometry.scroll<=v.audit.geometry.width+1),report.stateViews.filter((v:any)=>v.audit?.findings.length||v.audit?.geometry.scroll>v.audit?.geometry.width+1));
 check('no_page_errors',report.pageErrors.length===0,report.pageErrors);check('no_external_requests',report.externalRequests.length===0,report.externalRequests);report.status='passed';
}
