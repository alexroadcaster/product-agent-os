import test from 'node:test';
import assert from 'node:assert/strict';
import {writeFile,readFile} from 'node:fs/promises';
import {join} from 'node:path';
import {createHash} from 'node:crypto';
import {m2Fixture} from './m2-fixture.mts';
import {createLocalApplication} from '../../apps/local-service/src/http/application.mts';
import {createAppAgentGateway} from '../../apps/local-service/src/runtime/app-agent-gateway.mts';
async function paired(f:any,runtime?:any){const origin='http://127.0.0.1:49833',app=await createLocalApplication({store:f.store,origin,instanceId:'m2c',profileDirectory:join(f.root,'profile'),runtime,assetRoots:[]});const r=await app.handleRequest(new Request(origin+'/bootstrap/exchange',{method:'POST',headers:{host:'127.0.0.1:49833',origin,'content-type':'application/json'},body:JSON.stringify({code:app.issuePairingCode()})}));const cookie=r.headers.get('set-cookie')!.split(';')[0],csrf=(await r.json() as any).csrfToken;return async(path:string,input?:any)=>{const response=await app.handleRequest(new Request(origin+'/api/v1/projects/p'+path,{method:input===undefined?'GET':'POST',headers:{host:'127.0.0.1:49833',origin,cookie,'x-paos-csrf':csrf,'content-type':'application/json'},...(input===undefined?{}:{body:JSON.stringify(input)})}));return {status:response.status,body:await response.json() as any};};}

test('artifact catalog reads pinned documents, shows source time and rejects stale document proposals',async t=>{
 const f=await m2Fixture(t),content='# Plan\n\nReview the synthetic deployment scope.\n';await writeFile(join(f.root,'PLAN.md'),content);const request=await paired(f);const page=await request('/artifacts?kind=documents');assert.equal(page.status,200);const item=page.body.items.find((i:any)=>i.title==='PLAN.md');assert.ok(item);assert.equal(item.source.version,createHash('sha256').update(content).digest('hex'));assert.ok(item.source.modifiedAt);const read=await request('/artifacts/'+item.id+'?version='+item.source.version);assert.equal(read.body.body,content);assert.equal(read.body.outline[0].line,1);
 const preview=await request('/artifacts/proposals/preview',{documentId:item.id,sourceVersion:item.source.version,body:content+'Reviewed.\n'});assert.equal(preview.status,200);assert.equal(preview.body.applied,false);await writeFile(join(f.root,'PLAN.md'),content+'Concurrent edit.');const stale=await request('/artifacts/proposals',{...preview.body,body:content+'Reviewed.\n',epoch:1,idempotencyKey:'stale-document'});assert.equal(stale.status,409);assert.equal(await readFile(join(f.root,'PLAN.md'),'utf8'),content+'Concurrent edit.');
});

test('skill generation requires meaningful grounding even without an App worker',async t=>{const f=await m2Fixture(t),request=await paired(f);const result=await request('/team/skills/generation',{mode:'description',description:''});assert.equal(result.status,400);assert.equal(result.body.error.code,'INSUFFICIENT_REQUIREMENTS');});
async function planning(t:any,mode:'requirements'|'description'='requirements',transform?:(value:any)=>any,expectedState='completed'){
 const f=await m2Fixture(t),source='# Requirements\n\nR-1: Review source changes and preserve approval boundaries.\nR-2: Tie every finding to an evidence path.\n';await writeFile(join(f.root,'REQUIREMENTS.md'),source);await f.store.write({projectId:'p',actorId:'fixture',expectedAuthorityEpoch:1,idempotencyKey:'session',changes:[{expectedRevision:0,entity:{id:'planning',kind:'session'}}]});
 const gateway=createAppAgentGateway({store:f.store,profileId:'m2c-test',actorId:'app',assetRoots:[]});f.beforeClose(()=>gateway.close());await gateway.connection.connect({});const worker=await gateway.agent('attach',{hostIdentity:'codex_app',workerId:'worker',generation:'g'}),auth={workerId:worker.workerId,generation:worker.generation,leaseToken:worker.leaseToken},binding=await gateway.runtime.dispatch('bindings',{projectId:'p',sessionId:'planning',mode:'planning'}),request=await paired(f,gateway.runtime);
 const input={mode,description:mode==='description'?'Create a source review skill grounded in evidence.':'Focus on evidence.',expectedRevision:createHash('sha256').update(source).digest('hex'),startLine:1,endLine:4,sessionId:'planning',bindingId:binding.bindingId};const started=await request('/team/skills/generation',input);assert.equal(started.status,200,JSON.stringify(started.body));const claim=await gateway.agent('claim',auth);assert.equal(claim.job.proposalContext.assetKind,'skill');const refs=claim.job.proposalContext.requirementContext.refs;
 const proposal={kind:'skill',action:'create',name:'Scoped review',description:'Review source changes',content:'---\nname: scoped-review\ndescription: Review source changes\n---\n\n# Scoped review\nRequire a source evidence path for each finding.',dependencies:[],reason:'Requirement-backed project need',requirementIds:refs.map((ref:any)=>ref.id)};
 await gateway.agent('report',{...auth,runId:started.body.id,seq:1,idempotencyKey:'skill-final',status:'completed',text:JSON.stringify(transform?transform(proposal):proposal)});const result=await request('/team/skills/generation/'+started.body.id);assert.equal(result.body.state,expectedState,JSON.stringify(result.body));return {f,request,gateway,auth,input,result:result.body,started:started.body,source};
}

test('grounded skill planning returns a reviewed draft and repeats/apply reuse one job and asset',async t=>{
 const p=await planning(t);assert.match(p.result.proposal.content,/Requirement provenance/);assert.match(p.result.proposal.content,/requirements:1-4/);assert.equal((await p.request('/team/catalog')).body.assets.filter((a:any)=>a.management==='paos_managed').length,0);
 const repeated=await p.request('/team/skills/generation',p.input);assert.equal(repeated.body.id,p.started.id);const input={proposal:p.result.proposal,previewDigest:p.result.preview.previewDigest,epoch:1};const applied=await p.request('/team/skills/generation/'+p.started.id+'/apply',input);assert.equal(applied.status,200,JSON.stringify(applied.body));assert.deepEqual(await p.request('/team/skills/generation/'+p.started.id+'/apply',input),applied);assert.equal((await p.request('/team/catalog')).body.assets.filter((a:any)=>a.kind==='skill'&&a.management==='paos_managed').length,1);assert.equal((await p.request('/team/skills/generation',p.input)).body.state,'applied');const jobs=(await p.f.store.projectEntities('p')).filter((r:any)=>r.kind==='run');assert.equal(jobs.length,1);
});

test('edited generated skill cannot remove the SKILL.md header while retaining the provenance line',async t=>{
 const p=await planning(t),proposal={...p.result.proposal,content:'No valid SKILL header\nGeneration request: '+p.result.generationKey};const preview=await p.request('/team/proposals/preview',{proposal,expectedRevision:0});assert.equal(preview.status,200);const applied=await p.request('/team/skills/generation/'+p.started.id+'/apply',{proposal,previewDigest:preview.body.previewDigest,epoch:1});assert.equal(applied.status,400);assert.equal((await p.request('/team/catalog')).body.assets.filter((a:any)=>a.management==='paos_managed').length,0);
});

test('requirement drift stops generation Apply and does not persist the proposed skill',async t=>{
 const p=await planning(t);await writeFile(join(p.f.root,'REQUIREMENTS.md'),p.source+'New requirement.');const read=await p.request('/team/skills/generation/'+p.started.id);assert.equal(read.body.state,'stale');const applied=await p.request('/team/skills/generation/'+p.started.id+'/apply',{proposal:p.result.proposal,previewDigest:p.result.preview.previewDigest,epoch:1});assert.equal(applied.status,409);assert.equal((await p.request('/team/catalog')).body.assets.filter((a:any)=>a.management==='paos_managed').length,0);
});

test('native check projection marks a changed bound task revision stale',async t=>{
 const f=await m2Fixture(t),task=await f.create('Bound task');await f.store.write({projectId:'p',actorId:'fixture',expectedAuthorityEpoch:1,idempotencyKey:'native-check',changes:[{expectedRevision:0,entity:{id:'native-run',kind:'run',status:'completed',data:{appAgentRun:{id:'native-run',projectId:'p',sessionId:'planning',taskContext:{taskId:task.id,revision:task.revision,scopeDigest:'recorded-scope'},operations:[{operationId:'native-op',argv:['node','--version'],state:'completed',exitCode:0,stdout:'v26',stderr:''}]}}}}]});const request=await paired(f);let catalog=await request('/artifacts?kind=checks');const observed=catalog.body.items.find((i:any)=>i.id.startsWith('runtime-check-'));assert.equal(observed.check.stale,false);await f.command({action:'save',task:{...task.data,title:'Changed bound scope'},expectedRevision:task.revision,reason:'Changed after check'});catalog=await request('/artifacts?kind=checks');assert.equal(catalog.body.items.find((i:any)=>i.id===observed.id).check.stale,true);
});


test('description generation uses a description hash reference and rejects hallucinated requirement references',async t=>{
 const good=await planning(t,'description');assert.equal(good.result.requirements[0].id,'user-description');assert.equal(good.result.requirements[0].relativePath,null);assert.match(good.result.proposal.content,/user-description/);
 const bad=await planning(t,'description',p=>({...p,requirementIds:['invented-requirement']}),'invalid');assert.deepEqual(bad.result.validationErrors,['SKILL_REQUIREMENT_REFERENCE_INVALID']);const apply=await bad.request('/team/skills/generation/'+bad.started.id+'/apply',{proposal:good.result.proposal,previewDigest:good.result.preview.previewDigest,epoch:1});assert.equal(apply.status,400);assert.equal((await bad.request('/team/catalog')).body.assets.length,0);
});

test('a no-gap App result remains covered without creating an empty skill',async t=>{const p=await planning(t,'description',()=>({noGap:true,reason:'Existing capabilities cover the request.'}),'covered');assert.equal(p.result.proposal,undefined);assert.equal((await p.request('/team/catalog')).body.assets.length,0);});

test('concurrent same-grounding requests coalesce into one queued planning job',async t=>{
 const p=await planning(t),input={...p.input,description:'Different request with the same bounded source.'};const results=await Promise.all(Array.from({length:8},()=>p.request('/team/skills/generation',input)));assert.ok(results.every(r=>r.status===200));assert.equal(new Set(results.map(r=>r.body.id)).size,1);const first=await p.gateway.agent('claim',p.auth);assert.equal(first.job.runId,results[0].body.id);const jobs=(await p.f.store.projectEntities('p')).filter((r:any)=>r.kind==='run');assert.equal(jobs.length,2);
});

test('document proposals reject secrets, redact source before-images and replay without changing files',async t=>{
 const f=await m2Fixture(t),source='# Plan\n\napi_key=syntheticArtifactCanary24680\n';await writeFile(join(f.root,'PLAN.md'),source);const request=await paired(f),item=(await request('/artifacts?kind=documents')).body.items.find((i:any)=>i.title==='PLAN.md');
 const bad=await request('/artifacts/proposals/preview',{documentId:item.id,sourceVersion:item.source.version,body:'# Proposed\n\napi_key=syntheticProposalCanary24680\n'});assert.equal(bad.status,400);
 const preview=await request('/artifacts/proposals/preview',{documentId:item.id,sourceVersion:item.source.version,body:'# Proposed\n\nReview evidence.\n'});assert.equal(preview.status,200,JSON.stringify(preview.body));assert.ok(!JSON.stringify(preview.body).includes('syntheticArtifactCanary24680'));const input={documentId:item.id,sourceVersion:item.source.version,body:preview.body.after,previewDigest:preview.body.previewDigest,epoch:1,idempotencyKey:'proposal-retry'};const saved=await request('/artifacts/proposals',input);assert.equal(saved.status,200,JSON.stringify(saved.body));const replay=await request('/artifacts/proposals',input);assert.equal(replay.status,200);assert.equal(replay.body.id,saved.body.id);assert.equal(replay.body.replayed,true);assert.equal(await readFile(join(f.root,'PLAN.md'),'utf8'),source);const catalog=await request('/artifacts?kind=documents');assert.equal(catalog.body.items.filter((i:any)=>i.kind==='proposal').length,1);assert.ok(!JSON.stringify(await f.store.projectEntities('p')).includes('syntheticArtifactCanary24680'));
});
