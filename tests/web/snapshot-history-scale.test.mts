import {test} from 'node:test';
import assert from 'node:assert/strict';
import {DatabaseSync} from 'node:sqlite';
import {mkdtempSync,rmSync,mkdirSync} from 'node:fs';
import {bindProject} from '../../apps/local-service/src/adapters/project-sources.ts';
import {join} from 'node:path';
import {tmpdir} from 'node:os';
import {historySnapshotPage,artifactSummaryRows,artifactDocumentRow} from '../../apps/local-service/src/storage/history-snapshots.mts';
import {safePersistedText} from '../../apps/local-service/src/redaction/persisted.mts';
import {createSessionHistory} from '../../apps/local-service/src/sessions/service.mts';
import {createArtifactCatalog} from '../../apps/local-service/src/artifacts/service.mts';
import {m2Fixture} from './m2-fixture.mts';

function fixture(t:any){const root=mkdtempSync(join(tmpdir(),'paos-history-scale-')),db=new DatabaseSync(join(root,'store.sqlite'));t.after(()=>{db.close();rmSync(root,{recursive:true,force:true});});db.exec(`CREATE TABLE projects(id TEXT,root_identity TEXT,canonical_root TEXT,authority_epoch INTEGER);INSERT INTO projects VALUES('p','identity','synthetic',1);CREATE TABLE store_meta(key TEXT,value TEXT);CREATE TABLE entities(project_id TEXT,id TEXT,kind TEXT,parent_id TEXT,title TEXT,body TEXT,status TEXT,public_key TEXT,coverage TEXT,data TEXT,revision INTEGER,deleted INTEGER,updated_at TEXT);`);const insert=db.prepare('INSERT INTO entities VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)');function put(id:string,kind:string,body='',data:any={},parent:string|null=null){insert.run('p',id,kind,parent,id,body,'active',null,'complete',JSON.stringify(data),1,0,'2026-11-15');}return {db,put};}
function map(row:any):any{return {id:row.id,kind:row.kind,parentId:row.parent_id,title:row.title,body:safePersistedText(row.body),data:JSON.parse(row.data),revision:row.revision,journalOrder:row.journal_order};}

test('history service uses bounded frozen paging instead of the failing all-history API',async()=>{let calls=0;const store:any={historyRows:async()=>{throw Object.assign(Error('HISTORY_TOO_LARGE'),{code:'HISTORY_TOO_LARGE'});},historySnapshotPage:async(_project:string,input:any)=>{calls++;assert.equal(input.mode,'catalog');return {items:[],nextCursor:null,previousCursor:null,snapshot:{generation:'synthetic',total:0,createdAt:'2026-11-15'}};}};const result=await createSessionHistory(store).catalog('p',new URLSearchParams());assert.equal(result.items.length,0);assert.equal(calls,1);});

test('100k-message frozen transcript preserves values/membership and maps only bounded pages',t=>{const {db,put}=fixture(t);db.exec('BEGIN');put('s','session');for(let i=0;i<100000;i++)put('m'+i,'message','Synthetic visible '+i+' '+ 'x'.repeat(1024),{role:'user'},'s');put('hidden','message','private canary',{role:'analysis'},'s');put('other-session','message','excluded',{role:'user'},'other');db.exec('COMMIT');let mapped=0;const mapper=(r:any)=>{mapped++;return map(r);};const first=historySnapshotPage(db,mapper,{projectId:'p',mode:'transcript',sessionId:'s',limit:2});assert.equal(first.snapshot.total,100000);assert.equal(mapped,2);assert.ok(first.nextCursor);db.prepare("UPDATE entities SET body='edited',deleted=1 WHERE id='m2'").run();put('inserted','message','new',{},'s');const next=historySnapshotPage(db,mapper,{projectId:'p',mode:'transcript',sessionId:'s',limit:2,cursor:first.nextCursor!});assert.equal(next.items[0].id,'m2');assert.match(next.items[0].body,/Synthetic visible 2/);assert.equal(next.snapshot.total,100000);assert.equal(mapped,4);assert.ok(Buffer.byteLength(JSON.stringify(next))<=1024*1024);});

test('catalog filters before message materialization and snapshots inherited task/run attribution',t=>{const {db,put}=fixture(t);put('s','session','',{});put('task','task','',{sessionIds:['s']});put('run','run','',{appAgentRun:{sessionId:'s',route:'codex_app_agent',assetPins:[{kind:'agent',assetId:'reviewer'}]}});put('m','message','x'.repeat(2*1024*1024),{role:'user'},'s');let mapped=0;const page=historySnapshotPage(db,r=>{mapped++;return map(r);},{projectId:'p',mode:'catalog',limit:50,filters:{agentId:'reviewer',taskId:'task'}});assert.equal(page.items.length,1);assert.equal(page.items[0].data.taskId,'task');assert.equal(mapped,1);});

test('snapshot LRU/expiry and scope drift fail explicitly; hidden/search output remains redacted',t=>{const {db,put}=fixture(t);put('s','session');put('m1','message','visible password=synthetic',{role:'user'},'s');put('m2','message','visible second',{role:'assistant'},'s');put('h','message','visible hidden',{channel:'analysis'},'s');let now=0;const options={maxSnapshots:1,now:()=>now};const first=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1},options);assert.equal(first.snapshot.total,2);assert.match(first.items[0].body,/\[redacted\]/);historySnapshotPage(db,map,{projectId:'p',mode:'catalog',limit:1},options);assert.throws(()=>historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1,cursor:first.nextCursor!},options),{code:'CURSOR_STALE'});const current=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1},options);now=16*60_000;assert.throws(()=>historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1,cursor:current.nextCursor!},options),{code:'CURSOR_STALE'});const bound=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1},options);db.exec("UPDATE projects SET root_identity='different'");assert.throws(()=>historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1,cursor:bound.nextCursor!},options),{code:'CURSOR_STALE'});});

test('artifact document summaries truncate in SQL before mapping and omit unrelated messages',t=>{const {db,put}=fixture(t);db.exec('BEGIN');for(let i=0;i<1000;i++)put('d'+i,'document','x'.repeat(107315));put('message','message','y'.repeat(1024*1024));db.exec('COMMIT');let mapped=0;const rows=artifactSummaryRows(db,r=>{mapped++;assert.ok(Buffer.byteLength(r.body)<=1120);return map(r);},'p',{kinds:['document']});assert.equal(rows.length,1000);assert.equal(mapped,1000);assert.equal((rows[0] as any).bodyPreviewTruncated,true);});

test('page byte cap advances without losing messages and oversized document reads reject before mapping',t=>{const {db,put}=fixture(t);put('s','session');put('a','message','a'.repeat(600000),{},'s');put('b','message','b'.repeat(600000),{},'s');const first=historySnapshotPage(db,map,{projectId:'p',mode:'transcript',sessionId:'s',limit:100});assert.equal(first.items.length,1);assert.ok(Buffer.byteLength(JSON.stringify(first))<=1024*1024);const last=historySnapshotPage(db,map,{projectId:'p',mode:'transcript',sessionId:'s',limit:100,cursor:first.nextCursor!});assert.equal(last.items[0].id,'b');assert.equal(last.nextCursor,null);put('too-large','document','x'.repeat(524289));let mapped=0;assert.throws(()=>artifactDocumentRow(db,r=>{mapped++;return map(r);},'p','too-large'),{code:'DOCUMENT_TOO_LARGE'});assert.equal(mapped,0);});

test('over-budget freeze rolls back without invalidating prior cursor and Unicode search remains compatible',t=>{const {db,put}=fixture(t);put('s','session');put('a','message','ПРОЕКТ first',{},'s');put('b','message','ПРОЕКТ second',{},'s');const options={maxBytes:2000};const first=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'проект',limit:1},options);assert.equal(first.snapshot.total,2);put('large','message','ПРОЕКТ '+'x'.repeat(3000),{},'s');assert.throws(()=>historySnapshotPage(db,map,{projectId:'p',mode:'transcript',sessionId:'s',limit:1},options),{code:'HISTORY_SNAPSHOT_BUSY'});const next=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'проект',limit:1,cursor:first.nextCursor!},options);assert.equal(next.items[0].id,'b');assert.equal(next.snapshot.total,2);});

test('LRU touches remain ordered within the same millisecond',t=>{const {db,put}=fixture(t);put('s','session');put('a','message','visible first',{},'s');put('b','message','visible second',{},'s');const options={maxSnapshots:2,now:()=>0};const first=historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1},options),second=historySnapshotPage(db,map,{projectId:'p',mode:'transcript',sessionId:'s',limit:1},options);historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1,cursor:first.nextCursor!},options);historySnapshotPage(db,map,{projectId:'p',mode:'catalog',limit:1},options);assert.throws(()=>historySnapshotPage(db,map,{projectId:'p',mode:'transcript',sessionId:'s',limit:1,cursor:second.nextCursor!},options),{code:'CURSOR_STALE'});assert.equal(historySnapshotPage(db,map,{projectId:'p',mode:'search',query:'visible',limit:1,cursor:first.nextCursor!},options).items[0].id,'b');});

test('artifact summary cursor keeps original body/status after edit and archive',async t=>{const f=await m2Fixture(t);const workspace=join(f.root,'workspace');mkdirSync(workspace);const pin=await bindProject('q',workspace);await f.store.registerProject({id:'q',keyPrefix:'QQQQ',canonicalRoot:pin.workspaceRoot,rootIdentity:pin.directoryIdentity,authorityMode:'sql'});for(const id of ['a','b'])await f.store.write({projectId:'q',actorId:'test',expectedAuthorityEpoch:1,idempotencyKey:'doc-'+id,changes:[{expectedRevision:0,entity:{id,kind:'document',title:id,body:'original '+id}}]});const service=createArtifactCatalog(f.store),first=await service.catalog('q',new URLSearchParams({kind:'documents',limit:'1'}));await f.store.write({projectId:'q',actorId:'test',expectedAuthorityEpoch:1,idempotencyKey:'edit-b',changes:[{expectedRevision:1,entity:{id:'b',kind:'document',title:'changed',body:'changed body',status:'archived'}}]});const next=await service.catalog('q',new URLSearchParams({kind:'documents',limit:'1',cursor:first.nextCursor!}));assert.equal(next.items[0].title,'b');assert.equal(next.items[0].preview,'original b');assert.notEqual(next.items[0].status,'archived');const read=await service.read('q','b');assert.equal(read.body,'changed body');});
